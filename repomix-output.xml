                  exit={{ opacity: 0, x: -12 }}
                  transition={{ duration: 0.2, ease: [0.25, 0.1, 0.15, 1] }}
                >
                  <View />
                </m.div>
              </AnimatePresence>
            </div>
          </div>
        </DialogContent>
      </Dialog>
    )
  }

  return (
    <Dialog open={open} onOpenChange={onOpenChange}>
      <DialogContent
        showCloseButton
        initialFocus={false}
        className="flex max-h-[85dvh] flex-col gap-0 overflow-hidden p-0"
      >
        <DialogHeader className="px-5 pt-5 pb-0">
          <DialogTitle>Paramètres</DialogTitle>
        </DialogHeader>

        <SettingsNav
          active={active}
          onActiveChange={onActiveChange}
          className="flex shrink-0 flex-wrap gap-1.5 px-5 pt-4 pb-1"
          itemClassName="shrink-0 rounded-full px-3.5"
        />

        <div className="min-h-0 flex-1 overflow-y-auto px-5 pt-3 pb-6">
          <AnimatePresence mode="wait" initial={false}>
            <m.div
              key={section.id}
              initial={{ opacity: 0, y: 8 }}
              animate={{ opacity: 1, y: 0 }}
              exit={{ opacity: 0, y: -8 }}
              transition={{ duration: 0.2, ease: [0.25, 0.1, 0.15, 1] }}
            >
              <View />
            </m.div>
          </AnimatePresence>
        </div>
      </DialogContent>
    </Dialog>
  )
}
