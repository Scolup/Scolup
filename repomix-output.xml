<file path="src/pages/postits/helpers.ts">
export interface PostIt {
  key: string
  html: string
  date?: string
  author?: string
  tint: string
}

export const NO_NOTES: PostIt[] = []

const NOTE_TINTS = [
  "border-amber-200/70 bg-amber-100 text-amber-950 dark:border-amber-400/20 dark:bg-amber-400/10 dark:text-amber-100",
  "border-pink-200/70 bg-pink-100 text-pink-950 dark:border-pink-400/20 dark:bg-pink-400/10 dark:text-pink-100",
  "border-sky-200/70 bg-sky-100 text-sky-950 dark:border-sky-400/20 dark:bg-sky-400/10 dark:text-sky-100",
  "border-emerald-200/70 bg-emerald-100 text-emerald-950 dark:border-emerald-400/20 dark:bg-emerald-400/10 dark:text-emerald-100",
  "border-violet-200/70 bg-violet-100 text-violet-950 dark:border-violet-400/20 dark:bg-violet-400/10 dark:text-violet-100",
]

function asString(value: unknown): string {
  return typeof value === "string" ? value.trim() : ""
}

export function tintFor(raw: Record<string, unknown>, index: number): string {
  const match = asString(raw.type).match(/(\d+)\s*$/)
  const n = match ? Number(match[1]) : Number(raw.id)
  const i = Number.isFinite(n) ? Math.abs(n) : index
  return NOTE_TINTS[i % NOTE_TINTS.length]
}

export function toPostIt(
  raw: Record<string, unknown>,
  index: number
): PostIt | null {
  const html = asString(raw.contenu)
  if (!html) return null
  const auteur = raw.auteur as Record<string, unknown> | undefined
  const author =
    auteur &&
    [asString(auteur.prenom), asString(auteur.nom)].filter(Boolean).join(" ")
  return {
    key: String((raw.id as number | string | undefined) ?? `postit-${index}`),
    html,
    date: asString(raw.dateDebut) || asString(raw.dateCreation) || undefined,
    author: author || undefined,
    tint: tintFor(raw, index),
  }
}
</file>

<file path="src/pages/settings/components/AccountSettings.tsx">
"use client"

import { useEffect, useState } from "react"
import { HugeiconsIcon } from "@hugeicons/react"
import { Mail01Icon, SchoolIcon } from "@hugeicons/core-free-icons"
import { ld } from "@/services/litedirecte"
import { Avatar, AvatarFallback, AvatarImage } from "@/components/ui/avatar"
import { initialsFromName } from "@/lib/utils"

interface AccountInfo {
  name: string
  initials: string
  photo: string | null
  email: string | null
  school: string | null
  klass: string | null
}

function readAccount(): AccountInfo {
  const account = ld.auth.getAccount()
  if (!account) {
    return {
      name: "",
      initials: "?",
      photo: null,
      email: null,
      school: null,
      klass: null,
    }
  }
  const name = `${account.prenom ?? ""} ${account.nom ?? ""}`.trim()
  return {
    name,
    initials: name ? initialsFromName(name) : "?",
    photo: account.profile?.photo || null,
    email: account.email || null,
    school: account.nomEtablissement || null,
    klass: account.profile?.classe?.libelle || null,
  }
}

function InfoRow({
  icon,
  label,
  value,
}: {
  icon: typeof Mail01Icon
  label: string
  value: string
}) {
  return (
    <div className="flex items-center gap-3">
      <HugeiconsIcon
        icon={icon}
        strokeWidth={1.5}
        aria-hidden="true"
        className="size-5 shrink-0 text-muted-foreground"
      />
      <div className="flex min-w-0 flex-col">
        <span className="text-xs text-muted-foreground">{label}</span>
        <span className="truncate text-sm font-medium text-card-foreground">
          {value}
        </span>
      </div>
    </div>
  )
}

export function AccountSettings() {
  const [info, setInfo] = useState<AccountInfo | null>(null)

  useEffect(() => {
    let active = true
    void ld.auth.loadSession().then(() => {
      if (active) setInfo(readAccount())
    })
    return () => {
      active = false
    }
  }, [])

  if (!info) return null

  return (
    <div className="flex flex-col gap-3">
      <p className="px-1 text-sm text-muted-foreground">Compte connecté</p>
      <div className="flex flex-col gap-4 rounded-3xl border border-border/70 bg-card px-4 py-5">
        <div className="flex items-center gap-3">
          <Avatar size="lg">
