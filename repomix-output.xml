<file path="src/hooks/use-reauth.ts">
import { useCallback, useEffect, useState, type FormEvent } from "react"
import type { LoginChallenge } from "litedirecte"
import { ld } from "@/services/litedirecte"
import { errorMessage } from "@/services/errors"
import { resetOnboarding } from "@/services/onboarding"

export type ReauthPhase = "credentials" | "2fa"

export interface ReauthModel {
  /** True while Litedirecte reports that the session needs a fresh login. */
  required: boolean
  phase: ReauthPhase
  challenge: LoginChallenge | null
  identifier: string
  selectedChoice: number | null
  submitting: boolean
  error: string | null
  showPassword: boolean
  togglePassword: () => void
  submit: (event: FormEvent<HTMLFormElement>) => void
  answer: (index: number) => void
  backToCredentials: () => void
  logout: () => void
}

function isAuthRequired(): boolean {
  try {
    return ld.sync.getState().state === "auth-required"
  } catch {
    return false
  }
}

/**
 * Drives the re-authentication sheet. Litedirecte flags an unrecoverable
 * session through `ld.sync` (`auth-required`); a successful `ld.auth.login`
 * clears it, which closes the sheet on its own.
 */
export function useReauth(): ReauthModel {
  const [required, setRequired] = useState(isAuthRequired)
  const [phase, setPhase] = useState<ReauthPhase>("credentials")
  const [challenge, setChallenge] = useState<LoginChallenge | null>(null)
  const [selectedChoice, setSelectedChoice] = useState<number | null>(null)
  const [submitting, setSubmitting] = useState(false)
  const [error, setError] = useState<string | null>(null)
  const [showPassword, setShowPassword] = useState(false)

  useEffect(() => {
    const off = ld.sync.onChange((state) => {
      setRequired(state.state === "auth-required")
    })
    return off
  }, [])

  // A new expiry means a fresh form: drop any previous challenge or error.
  useEffect(() => {
    if (!required) return
    setPhase("credentials")
    setChallenge(null)
    setSelectedChoice(null)
    setError(null)
    setSubmitting(false)
  }, [required])

  const submit = useCallback((event: FormEvent<HTMLFormElement>) => {
    event.preventDefault()
    const data = new FormData(event.currentTarget)
    const identifier = (data.get("identifier") as string)?.trim()
    const password = data.get("password") as string
    if (!identifier || !password) {
      setError("Renseigne ton identifiant et ton mot de passe.")
      return
    }

    setSubmitting(true)
    setError(null)
    ld.auth
      .login(identifier, password, { rememberMe: true })
      .then((result) => {
        if (result.type === "success") return
        setChallenge(result)
        setPhase("2fa")
      })
      .catch((err) => setError(errorMessage(err, "Connexion échouée.")))
      .finally(() => setSubmitting(false))
  }, [])

  const answer = useCallback(
    (index: number) => {
      if (!challenge) return
      setSelectedChoice(index)
      setSubmitting(true)
      setError(null)
      challenge
        .answer(index)
        .catch((err) => {
          setError(errorMessage(err, "Réponse incorrecte."))
          setSelectedChoice(null)
        })
        .finally(() => setSubmitting(false))
    },
    [challenge]
  )

  const backToCredentials = useCallback(() => {
    setPhase("credentials")
    setChallenge(null)
    setSelectedChoice(null)
    setError(null)
  }, [])

  const logout = useCallback(() => {
    void ld.auth.logout().catch(() => {})
    void resetOnboarding().finally(() => {
      window.location.href = "/"
    })
  }, [])

  return {
    required,
    phase,
    challenge,
    identifier: ld.auth.getAccount()?.identifiant ?? "",
    selectedChoice,
    submitting,
    error,
    showPassword,
    togglePassword: () => setShowPassword((shown) => !shown),
    submit,
    answer,
    backToCredentials,
    logout,
  }
}
</file>

<file path="src/pages/agenda/components/AgendaHeader.tsx">
"use client"

import { useState } from "react"
import { m } from "motion/react"
import { HugeiconsIcon } from "@hugeicons/react"
import {
  ArrowLeft01Icon,
  ArrowRight01Icon,
  Calendar03Icon,
} from "@hugeicons/core-free-icons"
import { fr } from "react-day-picker/locale/fr"
import { cn } from "@/lib/utils"
import { Button } from "@/components/ui/button"
import { Calendar } from "@/components/ui/calendar"
import {
  Popover,
  PopoverContent,
  PopoverTrigger,
} from "@/components/ui/popover"
import { dayLabel } from "../helpers"
import {
  addDays,
  fullDateLabel,
  isoWeekNumber,
  monthLabel,
  shortDayName,
  toDayKey,
  weekOf,
} from "@/services/dates"
import type { AgendaView } from "../helpers"

interface AgendaHeaderProps {
  date: Date
  view: AgendaView
  onDateChange: (date: Date, dir?: number) => void
  onViewChange: (view: AgendaView) => void
}

function ViewSwitch({
  view,
  onViewChange,
  className,
  buttonClassName,
}: {
  view: AgendaView
  onViewChange: (view: AgendaView) => void
  className?: string
  buttonClassName?: string
}) {
  return (
    <div
      role="tablist"
      aria-label="Vue"
      className={cn(
        "flex shrink-0 items-center gap-0.5 rounded-full bg-input/50 p-0.5",
        className
      )}
    >
      {(["day", "week"] as const).map((value) => (
        <button
          key={value}
          type="button"
          role="tab"
          aria-selected={view === value}
          onClick={() => {
            onViewChange(value)
          }}
          className={cn(
            "relative rounded-full px-3 py-1 text-xs font-medium transition-colors duration-200 outline-none",
            "focus-visible:ring-3 focus-visible:ring-ring/30",
            buttonClassName,
            view === value
              ? "text-card-foreground"
              : "text-muted-foreground hover:text-foreground"
          )}
        >
          {view === value && (
            <m.span
              layoutId="agenda-view-pill"
              transition={{ type: "spring", stiffness: 500, damping: 35 }}
              className="absolute inset-0 rounded-full bg-card shadow-sm"
              aria-hidden="true"
            />
          )}
          <span className="relative">
            {value === "day" ? "Jour" : "Semaine"}
          </span>
        </button>
      ))}
    </div>
  )
}

export function AgendaHeader({
  date,
  view,
  onDateChange,
  onViewChange,
}: AgendaHeaderProps) {
  const week = weekOf(date)
  const selectedKey = toDayKey(date)
  const step = view === "week" ? 7 : 1
  const [pickerOpen, setPickerOpen] = useState(false)

  const go = (next: Date, dir?: number) => {
    onDateChange(next, dir)
  }

  const pickDate = (next: Date | undefined) => {
    if (!next) return
    go(new Date(next.getFullYear(), next.getMonth(), next.getDate()))
    setPickerOpen(false)
  }

  return (
    <div className="sticky top-0 z-20 flex flex-col gap-2 border-b border-border/60 bg-background/85 px-4 py-2 backdrop-blur-md">
      <div className="flex items-center justify-between gap-2">
        <div className="flex min-w-0 items-center gap-0.5">
          <Button
            variant="ghost"
            size="icon"
            className="size-8 shrink-0 rounded-full"
            aria-label={
              view === "week" ? "Semaine précédente" : "Jour précédent"
            }
            onClick={() => go(addDays(date, -step), -1)}
          >
            <HugeiconsIcon icon={ArrowLeft01Icon} className="size-4" />
          </Button>
          <Popover open={pickerOpen} onOpenChange={setPickerOpen}>
            <PopoverTrigger
              render={
                <button
                  type="button"
                  aria-label="Choisir une date"
                  title="Choisir une date"
                  className="flex min-w-0 shrink-0 cursor-pointer flex-col rounded-lg px-1 text-left transition-colors outline-none hover:bg-muted/60 focus-visible:ring-2 focus-visible:ring-ring/40"
                />
              }
            >
              <span className="flex items-center gap-1 truncate text-sm font-semibold text-card-foreground">
                <HugeiconsIcon
                  icon={Calendar03Icon}
                  className="size-3.5 shrink-0 text-muted-foreground"
                  aria-hidden="true"
                />
                {view === "week"
                  ? "Semaine " + isoWeekNumber(date)
                  : dayLabel(date)}
              </span>
              <span className="truncate text-xs text-muted-foreground">
                {view === "day" ? fullDateLabel(date) : monthLabel(date)}
              </span>
            </PopoverTrigger>
            <PopoverContent className="w-auto p-0" align="start">
              <Calendar
                mode="single"
                locale={fr}
                captionLayout="dropdown"
                selected={date}
                onSelect={pickDate}
              />
            </PopoverContent>
          </Popover>
          <Button
            variant="ghost"
            size="icon"
            className="size-8 shrink-0 rounded-full"
            aria-label={view === "week" ? "Semaine suivante" : "Jour suivant"}
            onClick={() => go(addDays(date, step), 1)}
          >
            <HugeiconsIcon icon={ArrowRight01Icon} className="size-4" />
          </Button>
        </div>

        <div className="flex shrink-0 items-center gap-1">
          <ViewSwitch
            view={view}
            onViewChange={onViewChange}
            className="hidden sm:flex"
          />
        </div>
      </div>

      <ViewSwitch
        view={view}
        onViewChange={onViewChange}
        className="w-full sm:hidden"
        buttonClassName="flex-1"
      />

      {view === "day" && (
        <div
          className="flex gap-0.5"
          role="tablist"
          aria-label="Jours de la semaine"
        >
          {week.map((day) => {
            const key = toDayKey(day)
            const isSelected = key === selectedKey
            const isDayToday = key === toDayKey(new Date())
            return (
              <button
                key={key}
                type="button"
                role="tab"
                aria-selected={isSelected}
                aria-label={dayLabel(day)}
                aria-current={isSelected ? "date" : undefined}
                onClick={() => go(day)}
                className="group flex min-w-0 flex-1 flex-col items-center gap-0.5 rounded-xl py-1.5 outline-none focus-visible:ring-2 focus-visible:ring-ring/40"
              >
                <span className="text-[10px] font-medium tracking-wide text-muted-foreground uppercase">
                  {shortDayName(day)}
                </span>
                <m.span
                  whileTap={{ scale: 0.88 }}
                  transition={{ type: "spring", stiffness: 500, damping: 22 }}
                  className={cn(
                    "relative flex size-8 items-center justify-center rounded-full text-sm tabular-nums transition-colors duration-200",
                    isSelected
                      ? "font-bold text-primary-foreground"
                      : isDayToday
                        ? "font-bold text-primary-text group-hover:bg-muted"
                        : "text-card-foreground group-hover:bg-muted"
                  )}
                >
                  {isSelected && (
                    <m.span
                      layoutId="agenda-day-pill"
                      transition={{
                        type: "spring",
                        stiffness: 500,
                        damping: 35,
                      }}
                      className="absolute inset-0 rounded-full bg-primary"
                      aria-hidden="true"
                    />
                  )}
                  <span className="relative">{day.getDate()}</span>
                </m.span>
              </button>
            )
          })}
        </div>
      )}
    </div>
  )
}
</file>

<file path="src/pages/agenda/components/CourseDrawer.tsx">
"use client"

import type { CSSProperties } from "react"
import {
  Building01Icon,
  Clock01Icon,
  DoorIcon,
  Note01Icon,
  TeacherIcon,
} from "@hugeicons/core-free-icons"
import { cn } from "@/lib/utils"
import { useSubjectDisplay } from "@/services/subjects"
import { Drawer, DrawerContent } from "@/components/ui/drawer"
import { Separator } from "@/components/ui/separator"
import { formatTime, fullDateLabel } from "@/services/dates"
import { courseRelativeLabel, durationLabel, type Course } from "../helpers"
import { CourseBadges } from "./CourseBadges"
import { CourseSession } from "./CourseSession"
import { DetailRow } from "@/ui/detail-row"

function timeValue(course: Course): string {
  if (!course.start || !course.end) return "Non précisé"
  const span = `${formatTime(course.start)} – ${formatTime(course.end)}`
  const duration = durationLabel(course)
  return duration ? `${span} · ${duration}` : span
}

export function CourseDrawer({
  course,
  onClose,
}: {
  course: Course | null
  onClose: () => void
}) {
  const { display, color } = useSubjectDisplay(
    course?.subjectCode,
    course?.title
  )

  return (
    <Drawer
      open={!!course}
      onOpenChange={(open) => {
        if (!open) onClose()
      }}
    >
      <DrawerContent>
        {course && (
          <div className="min-h-0 flex-1 overflow-y-auto overscroll-contain p-5 pb-[calc(1.25rem+env(safe-area-inset-bottom))]">
            <div className="flex flex-col gap-1">
              <span
                className={cn(
                  "text-lg font-bold break-words",
                  !color && "text-card-foreground",
                  color &&
                    "text-[color-mix(in_srgb,var(--c)_60%,black)] dark:text-[color-mix(in_srgb,var(--c)_60%,white)]",
                  course.cancelled &&
                    "line-through decoration-muted-foreground/50"
                )}
                style={color ? ({ "--c": color } as CSSProperties) : undefined}
              >
                {display}
              </span>
              <span className="text-xs text-muted-foreground">
                {course.start ? fullDateLabel(course.start) : ""}
                {!course.cancelled && courseRelativeLabel(course)
                  ? ` · ${courseRelativeLabel(course)}`
                  : ""}
              </span>
              <CourseBadges course={course} />
            </div>

            <Separator className="my-4" />

            <div className="flex flex-col gap-3">
              <DetailRow
                icon={Clock01Icon}
                label="Horaire"
                value={timeValue(course)}
              />
              {course.room && (
                <DetailRow icon={DoorIcon} label="Salle" value={course.room} />
              )}
              {course.details && (
                <DetailRow
                  icon={Note01Icon}
                  label="Détails"
                  value={course.details}
                />
              )}
              {course.teacher && (
                <DetailRow
                  icon={TeacherIcon}
                  label="Professeur"
                  value={course.teacher}
                />
              )}
              {course.group && (
                <DetailRow
                  icon={Building01Icon}
                  label="Groupe"
                  value={course.group}
                />
              )}
            </div>

            <CourseSession course={course} />
          </div>
        )}
      </DrawerContent>
    </Drawer>
  )
}
</file>

