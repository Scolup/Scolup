export function SubjectGroupSection({
  group,
  evalColors,
  highlightedKey,
  registerRow,
  onOpen,
}: {
  group: SubjectGroup
  evalColors: string[]
  highlightedKey: string | null
  registerRow: (key: string, el: HTMLElement | null) => void
  onOpen: (key: string) => void
