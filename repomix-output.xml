import { getDB } from "./storage"

export const RUBIES_KEY = "rubies"
const LEGACY_KEY = "scolup.rubies"

let cache = 0
let loaded = false
const listeners = new Set<() => void>()

function notify() {
  for (const l of listeners) l()
}

export async function loadRubies(): Promise<number> {
  if (loaded) return cache
  try {
    const db = await getDB()
    const v = await db.get("shop", RUBIES_KEY)
    if (typeof v === "number" && !Number.isNaN(v)) {
      cache = Math.max(0, Math.trunc(v))
      loaded = true
      return cache
    }
    try {
      const legacy = localStorage.getItem(LEGACY_KEY)
      if (legacy) {
        const n = Number.parseInt(legacy, 10)
        if (!Number.isNaN(n) && n > 0) {
          cache = Math.max(0, Math.trunc(n))
          await db.put("shop", cache, RUBIES_KEY)
          localStorage.removeItem(LEGACY_KEY)
        }
      }
    } catch {}
  } catch {}
  loaded = true
  return cache
}

// Re-read the balance from IndexedDB (after a transaction wrote it directly).
export async function reloadRubies(): Promise<void> {
  loaded = false
  await loadRubies()
  notify()
}

export function getRubies(): number {
  return cache
}

export async function setRubies(count: number): Promise<void> {
  const n = Math.max(0, Math.trunc(count))
  cache = n
  try {
    const db = await getDB()
    await db.put("shop", cache, RUBIES_KEY)
  } catch {}
  notify()
}

export async function addRubies(amount: number): Promise<number> {
  await loadRubies()
  const next = cache + Math.trunc(amount)
  if (next < 0) {
    cache = 0
    try {
      const db = await getDB()
      await db.put("shop", 0, RUBIES_KEY)
    } catch {}
    notify()
    return 0
  }
  await setRubies(next)
  return next
}

export function subscribeRubies(fn: () => void): () => void {
  listeners.add(fn)
  return () => listeners.delete(fn)
}
</file>

<file path="src/ui/accent-color-picker.tsx">
import { m } from "motion/react"
import { cn } from "@/lib/utils"
import { SHOP_ITEMS } from "@/services/shop-rules"

export type ThemeColor =
  | "yellow"
  | "red"
  | "green"
  | "blue"
  | "violet"
  | "pink"
  | "orange"
  | "teal"

interface ThemeOption {
  value: ThemeColor
  label: string
  color: string
  foreground: string
  itemId?: string // set for colors bought in the shop
}

const FREE_THEMES: ThemeOption[] = [
  { value: "yellow", label: "Jaune", color: "#e5af4b", foreground: "#1a1a1a" },
  { value: "red", label: "Rouge", color: "#dd0046", foreground: "#ffffff" },
  { value: "green", label: "Vert", color: "#25b256", foreground: "#ffffff" },
  { value: "blue", label: "Bleu", color: "#48B7E8", foreground: "#1a1a1a" },
]

// Colors sold in the shop come from the shop catalog: one source of truth.
const SHOP_THEMES: ThemeOption[] = SHOP_ITEMS.filter(
  (item) => item.kind === "accent"
).map((item) => ({
  value: item.value as ThemeColor,
  label: item.label,
  color: item.color,
  foreground: item.foreground,
  itemId: item.id,
}))

function handleThemeKeydown(
  event: React.KeyboardEvent,
  themes: ThemeOption[],
  currentIndex: number,
  onSelect: (color: ThemeColor) => void
) {
  const isLeftOrUp = event.key === "ArrowLeft" || event.key === "ArrowUp"
  const isRightOrDown = event.key === "ArrowRight" || event.key === "ArrowDown"
  const isConfirm = event.key === "Enter" || event.key === " "

  if (!isLeftOrUp && !isRightOrDown && !isConfirm) return

  event.preventDefault()

  if (isLeftOrUp) {
    const prevIndex = currentIndex > 0 ? currentIndex - 1 : themes.length - 1
    onSelect(themes[prevIndex].value)
  } else if (isRightOrDown) {
    const nextIndex = currentIndex < themes.length - 1 ? currentIndex + 1 : 0
    onSelect(themes[nextIndex].value)
  } else if (isConfirm) {
    onSelect(themes[currentIndex].value)
  }
}

interface AccentColorPickerProps {
  value: string
  label: string
  onPick: (color: ThemeColor) => void
  // Ids of the shop items the player owns. Bought colors only show up here.
  owned?: string[]
  className?: string
}

export function AccentColorPicker({
  value,
  label,
  onPick,
  owned = [],
  className,
}: AccentColorPickerProps) {
  const themes = [
    ...FREE_THEMES,
    ...SHOP_THEMES.filter(
      (theme) => theme.itemId && owned.includes(theme.itemId)
    ),
  ]

  return (
    <div
      role="group"
      aria-label={label}
      className={cn("grid grid-cols-4 gap-2", className)}
    >
      {themes.map((theme, index) => (
        <m.button
          key={theme.value}
          type="button"
          onClick={() => onPick(theme.value)}
          onKeyDown={(e) => handleThemeKeydown(e, themes, index, onPick)}
          aria-pressed={value === theme.value}
          aria-label={`Couleur ${theme.label}`}
          className="flex cursor-pointer flex-col items-center gap-2"
          whileHover={{ scale: 1.08 }}
          whileTap={{ scale: 0.92 }}
          transition={{ type: "spring", stiffness: 400, damping: 17 }}
        >
          <m.div
            style={{ backgroundColor: theme.color }}
            className={cn(
              "size-12 rounded-full",
              value === theme.value && "ring-2 ring-foreground ring-offset-2"
            )}
            animate={{
              scale: value === theme.value ? [1, 1.18, 1] : 1,
            }}
            transition={{
              type: "spring",
              stiffness: 400,
              damping: 14,
            }}
          >
            {value === theme.value && (
              <m.span
                className="flex h-full items-center justify-center"
                initial={{ scale: 0.5, opacity: 0 }}
                animate={{ scale: 1, opacity: 1 }}
                transition={{ type: "spring", stiffness: 500, damping: 15 }}
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  strokeWidth={3}
                  strokeLinecap="round"
                  strokeLinejoin="round"
                  className="size-5"
                  style={{ color: theme.foreground }}
                >
                  <m.path
                    d="M5 13l4 4L19 7"
                    initial={{ pathLength: 0 }}
                    animate={{ pathLength: 1 }}
                    transition={{ duration: 0.3, ease: "easeOut" }}
                  />
                </svg>
              </m.span>
            )}
          </m.div>
          <span className="text-xs text-muted-foreground">{theme.label}</span>
        </m.button>
      ))}
    </div>
  )
}
</file>

