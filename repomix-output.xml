<file path="src/services/storage.ts">
import { openDB, type DBSchema, type IDBPDatabase } from "idb"

export interface SubjectRecord {
  id: string
  code?: string
  name: string
  customName?: string
  customColor?: string
  coef?: number
}

interface ScolupDB extends DBSchema {
  settings: {
    key: string
    value: string | boolean
  }
  subjects: {
    key: string
    value: SubjectRecord
  }
  // "rubies" and "xp" are numbers; "owned" and "weekly" are JSON strings.
  shop: {
    key: string
    value: number | string
  }
  quests: {
    key: string
    value: string
  }
}

let dbInstance: IDBPDatabase<ScolupDB> | null = null

export async function getDB(): Promise<IDBPDatabase<ScolupDB>> {
  if (!dbInstance) {
    dbInstance = await openDB<ScolupDB>("scolup", 5, {
      upgrade(db, oldVersion) {
        if (oldVersion < 1) db.createObjectStore("settings")
        else if (!db.objectStoreNames.contains("settings")) {
          db.createObjectStore("settings")
        }
        if (oldVersion < 2 && !db.objectStoreNames.contains("subjects")) {
          db.createObjectStore("subjects")
        }
        if (oldVersion < 4 && !db.objectStoreNames.contains("shop")) {
          db.createObjectStore("shop")
        }
        if (oldVersion < 5 && !db.objectStoreNames.contains("quests")) {
          db.createObjectStore("quests")
        }
      },
    })
  }
  return dbInstance
}

export async function setSetting(
  key: string,
  value: string | boolean
): Promise<void> {
  try {
    localStorage.setItem(`scolup:${key}`, JSON.stringify(value))
  } catch {}
  const db = await getDB()
  await db.put("settings", value, key)
}

export async function getSetting(
  key: string
): Promise<string | boolean | undefined> {
  const db = await getDB()
  return db.get("settings", key)
}

export async function delSetting(key: string): Promise<void> {
  try {
    localStorage.removeItem(`scolup:${key}`)
  } catch {}
  const db = await getDB()
  await db.delete("settings", key)
}

export function getSettingSync(key: string): string | boolean | undefined {
  try {
    const raw = localStorage.getItem(`scolup:${key}`)
    if (raw === null) return undefined
    const parsed: unknown = JSON.parse(raw)
    return typeof parsed === "string" || typeof parsed === "boolean"
      ? parsed
      : undefined
  } catch {
    return undefined
  }
}

export async function readLastSeen(key: string): Promise<number> {
  const stored = await getSetting(`seen:${key}`)
  const parsed = typeof stored === "string" ? Number(stored) : 0
  return Number.isFinite(parsed) ? parsed : 0
}

export async function markSeen(key: string): Promise<void> {
  await setSetting(`seen:${key}`, String(Date.now()))
}

// Wipes every trace of Scolup preferences from the device. The user stays
// logged in (the session is Litedirecte's), so only a reload is needed.
export async function clearAllData(): Promise<void> {
  const db = await getDB()
  await Promise.all([db.clear("settings"), db.clear("subjects")])
  try {
    for (const key of Object.keys(localStorage)) {
      if (key.startsWith("scolup:")) localStorage.removeItem(key)
    }
  } catch {}
}
</file>

<file path="src/ui/offline-banner.tsx">
import { useEffect, useRef, useState } from "react"
import { AnimatePresence, m } from "motion/react"
import { HugeiconsIcon } from "@hugeicons/react"
import { WifiDisconnected01Icon } from "@hugeicons/core-free-icons"
import { ld } from "@/services/litedirecte"

function readBrowserOffline(): boolean {
  try {
    const nav = (globalThis as unknown as { navigator?: { onLine?: unknown } })
      .navigator
    return !!nav && nav.onLine === false
  } catch {
    return false
  }
}

export function OfflineBanner() {
  const [syncOffline, setSyncOffline] = useState(() => {
    try {
      return ld.sync.getState().state === "offline"
    } catch {
      return false
    }
  })
  const [browserOffline, setBrowserOffline] = useState(readBrowserOffline)
  // Transition de sortie : garde le bandeau monté 300 ms après le retour
  // en ligne pour un fondu, sans recharger la page.
  const [render, setRender] = useState(syncOffline || readBrowserOffline())
  const hideTimer = useRef<number | null>(null)

  useEffect(() => {
    setSyncOffline(ld.sync.getState().state === "offline")
    setBrowserOffline(readBrowserOffline())
    const offSync = ld.sync.onChange((state) => {
      setSyncOffline(state.state === "offline")
    })
    const onOffline = () => setBrowserOffline(true)
    const onOnline = () => setBrowserOffline(false)
    window.addEventListener("offline", onOffline)
    window.addEventListener("online", onOnline)
    return () => {
      offSync()
      window.removeEventListener("offline", onOffline)
      window.removeEventListener("online", onOnline)
    }
  }, [])

  const offline = syncOffline || browserOffline

  useEffect(() => {
    if (offline) {
      if (hideTimer.current !== null) clearTimeout(hideTimer.current)
      setRender(true)
      return
    }
    hideTimer.current = window.setTimeout(() => setRender(false), 300)
    return () => {
      if (hideTimer.current !== null) clearTimeout(hideTimer.current)
    }
  }, [offline])

  if (!render) return null

  return (
    <AnimatePresence initial={false}>
      {offline && (
        <m.div
          role="status"
          initial={{ height: 0, opacity: 0, y: -8 }}
          animate={{ height: "auto", opacity: 1, y: 0 }}
          exit={{ height: 0, opacity: 0, y: -8 }}
          transition={{ duration: 0.25, ease: [0.25, 0.1, 0.15, 1] }}
          className="flex min-h-0 items-center justify-center overflow-hidden px-4 py-0.5"
        >
          <p className="flex min-w-0 items-center justify-center gap-1 text-center text-[11px] leading-tight text-muted-foreground/60">
            <HugeiconsIcon
              icon={WifiDisconnected01Icon}
              strokeWidth={2}
              className="size-3 shrink-0"
              aria-hidden="true"
            />
            <span className="truncate">Hors ligne</span>
          </p>
        </m.div>
      )}
    </AnimatePresence>
  )
}
</file>

<file path="src/pages/grades/hooks/useGrades.ts">
import { useEffect, useMemo, useState } from "react"
import { ld } from "@/services/litedirecte"
import { errorMessage } from "@/services/errors"
import { getSetting } from "@/services/storage"
import { syncGrades } from "@/services/quests"
import {
  ensureSubjects,
  resolveSubjectCoef,
  useSubjects,
} from "@/services/subjects"
import { useLiveRefresh } from "@/hooks/use-live-refresh"
import { useAverageSettings } from "@/services/average-settings"
import {
  computeOverallAverage,
  cumulativeGeneralAverageByDay,
  groupBySubject,
  resolvePeriod,
  toGrade,
  toPeriod,
  toEvalColors,
  DEFAULT_EVAL_COLORS,
  type Grade,
  type Period,
  type TrendPoint,
} from "../helpers"

export interface GradesModel {
  grades: Grade[]
  groups: ReturnType<typeof groupBySubject>
  overallAverage: number | null
  periods: Period[]
  selectedPeriod: string
  setSelectedPeriod: (id: string) => void
  evalColors: string[]
  trend: TrendPoint[]
  hasTrend: boolean
  trendDomain: [number, number]
  recentGrades: Grade[]
  loading: boolean
  error: string | null
  retry: () => void
}

const RECENT_DAYS = 15
const NO_GRADES: Grade[] = []
const NO_PERIODS: Period[] = []

export function useGrades(): GradesModel {
  const [payload, setPayload] = useState<{
    grades: Grade[]
    periods: Period[]
    evalColors: string[]
    selectedPeriod: string
  } | null>(null)
  const [selectedPeriod, setSelectedPeriod] = useState("")
  const [loading, setLoading] = useState(true)
  const [error, setError] = useState<string | null>(null)
  const [reloadKey, setReloadKey] = useState(0)
  const liveGrades = useLiveRefresh("grades")

  useEffect(() => {
    let cancelled = false
    ;(async () => {
      // The skeleton belongs to the first load. Later runs (retry, live refresh)
      // keep the current payload on screen and swap it when it lands.
      setLoading(payload === null)
      try {
        if (!(await ld.auth.loadSession())) {
          throw new Error("Aucune session active. Reconnecte-toi.")
        }
        const result = (await ld.grades.getGrades()) as {
          notes?: unknown
          periodes?: unknown
          parametrage?: unknown
        }
        if (cancelled) return
        const raw = Array.isArray(result.notes) ? result.notes : []
        const grades = (raw as Record<string, unknown>[]).map(toGrade)
        void syncGrades(grades)
        void ensureSubjects(
          grades.map((grade) => ({
            code: grade.subjectCode,
            name: grade.subject,
          }))
        )
        const rawPeriods = Array.isArray(result.periodes) ? result.periodes : []
        const periods = (rawPeriods as Record<string, unknown>[])
          .map(toPeriod)
          .filter((period): period is Period => period !== null)
        const stored = await getSetting("gradesPeriod")
        if (cancelled) return
        const defaultPeriod =
          resolvePeriod(
            periods,
            typeof stored === "string" ? stored : undefined
          )?.id ?? ""
        setPayload({
          grades,
          periods,
          evalColors: toEvalColors(result.parametrage),
          selectedPeriod: defaultPeriod,
        })
        // Keep the period the user picked across a background refresh, as long
        // as it still exists in the payload.
        setSelectedPeriod((prev) =>
          prev && periods.some((period) => period.id === prev)
            ? prev
            : defaultPeriod
        )
        setError(null)
      } catch (err) {
        if (cancelled) return
        // Same rule as `useAsync`: only a first load with nothing on screen
        // reports the error.
        if (payload !== null) return
        setError(errorMessage(err, "Impossible de charger les notes."))
      } finally {
        if (!cancelled) setLoading(false)
      }
    })()
    return () => {
      cancelled = true
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [reloadKey, liveGrades])

  const grades = payload?.grades ?? NO_GRADES
  const periods = payload?.periods ?? NO_PERIODS
  const evalColors = payload?.evalColors ?? DEFAULT_EVAL_COLORS
  // Se re-rend quand une matière change : les memos ci-dessous en dépendent
  // pour recalculer les moyennes pondérées par coefficient.
  const subjects = useSubjects()
  const coefOf = useMemo(
    () => (code?: string, name?: string) => resolveSubjectCoef(code, name),
    [subjects]
  )

  const visibleGrades = useMemo(() => {
    const selected = periods.find((period) => period.id === selectedPeriod)
    if (selected?.annuel || selectedPeriod === "") return grades
    return grades.filter((grade) => grade.period === selectedPeriod)
  }, [grades, periods, selectedPeriod])

  const { method } = useAverageSettings()

  const groups = useMemo(
    () => groupBySubject(visibleGrades, coefOf),
    [visibleGrades, coefOf]
  )
  const overallAverage = useMemo(
    () => computeOverallAverage(visibleGrades, groups, coefOf, method),
    [visibleGrades, groups, coefOf, method]
  )
  const trend = useMemo(
    () =>
      cumulativeGeneralAverageByDay(
        visibleGrades,
        coefOf,
        30,
        new Date(),
        method
      ),
    [visibleGrades, coefOf, method]
  )
  const hasTrend = useMemo(
    () => trend.some((point) => point.average !== null),
    [trend]
  )
  const trendDomain = useMemo((): [number, number] => {
    let min = Number.POSITIVE_INFINITY
    let max = Number.NEGATIVE_INFINITY
    for (const point of trend) {
      if (point.average === null) continue
      if (point.average < min) min = point.average
      if (point.average > max) max = point.average
    }
    if (!Number.isFinite(min) || !Number.isFinite(max)) return [0, 20]
    return [Math.max(0, min - 0.5), Math.min(20, max + 0.5)]
  }, [trend])

  const recentGrades = useMemo(() => {
    const cutoff = Date.now() - RECENT_DAYS * 86_400_000
    return visibleGrades
      .filter(
        (grade) =>
          grade.enteredOn instanceof Date && grade.enteredOn.getTime() >= cutoff
      )
      .sort(
        (a, b) =>
          (b.enteredOn as Date).getTime() - (a.enteredOn as Date).getTime()
      )
  }, [visibleGrades])

  return {
    grades,
    groups,
    overallAverage,
    periods,
    selectedPeriod,
    setSelectedPeriod,
    evalColors,
    trend,
    hasTrend,
    trendDomain,
    recentGrades,
    loading,
    error,
    retry: () => {
      setError(null)
      setReloadKey((key) => key + 1)
    },
  }
}
</file>

<file path="src/pages/home/HomePage.tsx">
import { Chair02Icon, StickyNote02Icon } from "@hugeicons/core-free-icons"
import { HugeiconsIcon } from "@hugeicons/react"
import { useHomePage } from "./hooks/useHomePage"
import { AccountMenu } from "./components/AccountMenu"
import { ContractCard } from "./components/ContractCard"
