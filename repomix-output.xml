export interface MessageListProps {
  folder: FolderKey
  onFolderChange: (value: FolderKey) => void
  input: string
  onInputChange: (value: string) => void
  loading: boolean
  error: string | null
  onRetry: () => void
  messages: Message[]
  query: string
  unreadMessages: Message[]
  showUnreadHighlights: boolean
  pageMessages: Message[]
  page: number
  currentPage: number
  totalPages: number
  pages: number[]
  leftEllipsis: boolean
  rightEllipsis: boolean
  onSelect: (message: Message) => void
  onPageChange: (page: number) => void
}

export function MessageList({
  folder,
  onFolderChange,
  input,
  onInputChange,
  loading,
  error,
  onRetry,
  messages,
  query,
  unreadMessages,
  showUnreadHighlights,
  pageMessages,
  page,
  currentPage,
  totalPages,
  pages,
  leftEllipsis,
  rightEllipsis,
  onSelect,
  onPageChange,
}: MessageListProps) {
  const containerRef = useRef<HTMLDivElement>(null)
  const showSkeleton = useDelayedLoading(loading)

  useEffect(() => {
    containerRef.current?.scrollIntoView({ block: "start", behavior: "smooth" })
  }, [folder, currentPage])

  return (
    <div
      ref={containerRef}
      className="flex min-h-[50dvh] w-full flex-col gap-0"
    >
      <FolderSearchBar
        folder={folder}
        onFolderChange={onFolderChange}
        input={input}
        onInputChange={onInputChange}
      />

      {loading ? (
        showSkeleton ? (
          <MessageListSkeleton />
        ) : null
      ) : error ? (
        <InlineError message={error} onRetry={onRetry} />
      ) : (
        <>
          <MessageRows
            folder={folder}
            unreadMessages={unreadMessages}
            showUnreadHighlights={showUnreadHighlights}
            messages={messages}
            pageMessages={pageMessages}
            query={query}
            page={currentPage}
            onSelect={onSelect}
          />

          <MessagePagination
            page={page}
            currentPage={currentPage}
            totalPages={totalPages}
            pages={pages}
            leftEllipsis={leftEllipsis}
            rightEllipsis={rightEllipsis}
            onPageChange={onPageChange}
          />
        </>
      )}
    </div>
  )
}
