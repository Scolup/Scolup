            <Skeleton className="h-4 w-4/5 rounded-full" />
          </div>
          <div className="flex flex-col gap-2">
            <Skeleton className="h-4 w-full rounded-full" />
            <Skeleton className="h-4 w-3/5 rounded-full" />
          </div>
        </m.div>
      ) : error ? (
        <m.div
          key="error"
          initial={{ opacity: 0, y: 6 }}
          animate={{ opacity: 1, y: 0 }}
