<file path="src/hooks/use-foreground-refresh.ts">
import { useCallback, useEffect } from "react"
import { ld } from "@/services/litedirecte"

// Seuil minimal entre deux rafraîchissements pour éviter les tempêtes.
const REFRESH_MIN_MS = 60_000

let lastAttempt = 0

function shouldRefresh(): boolean {
  const now = Date.now()
  if (now - lastAttempt < REFRESH_MIN_MS) return false
  try {
    const lastSync = ld.sync.getState().lastSync
    if (lastSync && now - lastSync < REFRESH_MIN_MS) return false
  } catch {}
  lastAttempt = now
  return true
}

// Refetch doux des ressources visibles, sans recharger la page. Utilise le
// poll Litedirecte existant (`getAll`) : aucune nouvelle requête ajoutée,
// aucune logique de cache modifiée. Les écrans montés se mettent à jour via
// `useLiveRefresh`.
export function refreshVisibleResources(): void {
  if (!shouldRefresh()) return
  void ld.getAll().catch(() => {})
}

export function useForegroundRefresh(): () => void {
  const refresh = useCallback(() => {
    refreshVisibleResources()
  }, [])

  useEffect(() => {
    const onVisible = () => {
      if (document.visibilityState === "visible") refreshVisibleResources()
    }
    document.addEventListener("visibilitychange", onVisible)
    return () => document.removeEventListener("visibilitychange", onVisible)
  }, [])

  return refresh
}
</file>

<file path="src/hooks/use-live-refresh.ts">
import { useEffect, useState } from "react"
import { ld } from "@/services/litedirecte"
import type { Resource } from "litedirecte"

/**
 * Counts Litedirecte cache writes for `resource`.
 *
 * Litedirecte already refetches every resource on a timer, so a mounted screen
 * only has to learn that a poll landed. It fires on a changed payload only,
 * never on an identical one, so an idle app costs no re-renders.
 */
export function useLiveRefresh(resource: Resource | undefined): number {
  const [version, setVersion] = useState(0)
  useEffect(() => {
    if (!resource) return undefined
    const stop = ld.cache.watch(resource, () =>
      setVersion((value) => value + 1)
    )
    return () => {
      stop()
    }
  }, [resource])
  return version
}
</file>

<file path="src/onboarding/hooks/useLogin.ts">
import { useCallback, useEffect, useState, type FormEvent } from "react"
import type { LoginChallenge } from "litedirecte"
import { ld } from "@/services/litedirecte"
import { errorMessage } from "@/services/errors"
type LoginPhase = "credentials" | "2fa"

export interface LoginModel {
  phase: LoginPhase
  challenge: LoginChallenge | null
  selectedChoice: number | null
  submitting: boolean
  error: string | null
  errorKey: number
  errorShake: boolean
  showPassword: boolean
  ready: boolean
  togglePassword: () => void
  submit: (event: FormEvent) => void
  answer: (index: number) => void
  backToCredentials: () => void
}

export function useLogin(onNext?: () => void): LoginModel {
  const [phase, setPhase] = useState<LoginPhase>("credentials")
  const [submitting, setSubmitting] = useState(false)
  const [error, setError] = useState<string | null>(null)
  const [challenge, setChallenge] = useState<LoginChallenge | null>(null)
  const [selectedChoice, setSelectedChoice] = useState<number | null>(null)
  const [showPassword, setShowPassword] = useState(false)
  const [errorShake, setErrorShake] = useState(false)
  const [ready, setReady] = useState(false)
  const [errorKey, setErrorKey] = useState(0)

  useEffect(() => {
    let cancelled = false
    ld.auth
      .loadSession()
      .then((restored) => {
        if (cancelled || !restored) return
        void ld.auth.refreshToken().catch(() => {})
        onNext?.()
      })
      .finally(() => {
        if (!cancelled) setReady(true)
      })
    return () => {
      cancelled = true
    }
  }, [onNext])

  const fail = useCallback((message: string) => {
    setError(message)
    setErrorKey((key) => key + 1)
    setErrorShake(true)
    setTimeout(() => setErrorShake(false), 500)
  }, [])

  const submit = useCallback(
    (event: FormEvent) => {
      event.preventDefault()
      setError(null)

      const data = new FormData(event.currentTarget as HTMLFormElement)
      const identifier = (data.get("identifier") as string)?.trim()
      const password = data.get("password") as string
      if (!identifier || !password) {
        setError("Renseigne ton identifiant et ton mot de passe.")
        return
      }

      setSubmitting(true)
      ld.auth
        .login(identifier, password, { rememberMe: true })
        .then((result) => {
          if (result.type === "success") onNext?.()
          else {
            setChallenge(result)
            setPhase("2fa")
          }
        })
        .catch((err) => fail(errorMessage(err, "Connexion échouée.")))
        .finally(() => setSubmitting(false))
    },
    [fail, onNext]
  )

  const answer = useCallback(
    (index: number) => {
      if (!challenge) return
      setSelectedChoice(index)
      setSubmitting(true)
      setError(null)
      challenge
        .answer(index)
        .then(() => onNext?.())
        .catch((err) => {
          setError(errorMessage(err, "Réponse incorrecte."))
          setSelectedChoice(null)
        })
        .finally(() => setSubmitting(false))
    },
    [challenge, onNext]
  )

  const backToCredentials = useCallback(() => {
    setPhase("credentials")
    setChallenge(null)
    setSelectedChoice(null)
    setError(null)
  }, [])

  return {
    phase,
    challenge,
    selectedChoice,
    submitting,
    error,
    errorKey,
    errorShake,
    showPassword,
    ready,
    togglePassword: () => setShowPassword((shown) => !shown),
    submit,
    answer,
    backToCredentials,
  }
}
</file>

<file path="src/pages/absences/hooks/useAttendance.ts">
import { useEffect, useMemo, useRef, useState } from "react"
import { ld } from "@/services/litedirecte"
import { errorMessage } from "@/services/errors"
import { useLiveRefresh } from "@/hooks/use-live-refresh"
import {
  attendanceStats,
  isEmptyAttendance,
  isNoAttendanceData,
  parseAttendance,
  type AttendanceEvent,
  type AttendancePayload,
  type MiscEvent,
} from "../helpers"

export interface AttendanceModel {
  events: AttendanceEvent[]
  sanctions: MiscEvent[]
  dispenses: MiscEvent[]
  isEmpty: boolean
  stats: ReturnType<typeof attendanceStats>
  loading: boolean
  error: string | null
  retry: () => void
}

const EMPTY: AttendancePayload = { events: [], sanctions: [], dispenses: [] }

export function useAttendance(): AttendanceModel {
  const [data, setData] = useState(EMPTY)
  const [loading, setLoading] = useState(true)
  const [error, setError] = useState<string | null>(null)
  const [reloadKey, setReloadKey] = useState(0)
  const liveAttendance = useLiveRefresh("attendance")
  const loaded = useRef(false)

  useEffect(() => {
    let cancelled = false
    ;(async () => {
      // Only the first load shows a skeleton; a live refresh swaps the
      // payload in place.
      setLoading(!loaded.current)
      try {
        if (!(await ld.auth.loadSession())) {
          throw new Error("Aucune session active. Reconnecte-toi.")
        }
        const result = (await ld.attendance.getAttendance()) as {
          absencesRetards?: unknown
          sanctionsEncouragements?: unknown
          dispenses?: unknown
        }
        if (cancelled) return
        loaded.current = true
        setData(parseAttendance(result))
        setError(null)
      } catch (err) {
        if (cancelled) return
        if (isNoAttendanceData(err)) {
          loaded.current = true
          setData(EMPTY)
          setError(null)
        } else if (!loaded.current) {
          setError(errorMessage(err, "Impossible de charger les absences."))
        }
      } finally {
        setLoading(false)
      }
    })()
    return () => {
      cancelled = true
    }
  }, [reloadKey, liveAttendance])

  const stats = useMemo(() => attendanceStats(data), [data])

  return {
    ...data,
    isEmpty: isEmptyAttendance(data),
    stats,
    loading,
    error,
    retry: () => {
      setError(null)
      setReloadKey((key) => key + 1)
    },
  }
}
</file>

<file path="src/pages/agenda/components/CourseCard.tsx">
import type { CSSProperties } from "react"
import { m } from "motion/react"
import { HugeiconsIcon } from "@hugeicons/react"
import { Location01Icon, User02Icon } from "@hugeicons/core-free-icons"
import { cn } from "@/lib/utils"
import { useSubjectDisplay } from "@/services/subjects"
import {
  countdownLabel,
  courseFlags,
  isHexColor,
  isOngoing,
  type Course,
  type CourseFlag,
} from "../helpers"

const textTone =
  "text-[color-mix(in_srgb,var(--c)_60%,black)] dark:text-[color-mix(in_srgb,var(--c)_60%,white)]"

const pillTones: Record<CourseFlag["tone"], string> = {
  destructive: "bg-destructive/15 text-destructive",
  warning: "bg-amber-500/15 text-amber-600 dark:text-amber-400",
  info: "bg-sky-500/15 text-sky-600 dark:text-sky-400",
  secondary: "bg-violet-500/15 text-violet-600 dark:text-violet-400",
}

const surfaces = {
  cancelled:
    "border-destructive/30 bg-destructive/[0.07] dark:bg-destructive/[0.12]",
  tinted:
    "border-[color-mix(in_srgb,var(--c)_30%,transparent)] bg-[color-mix(in_srgb,var(--c)_13%,var(--card))] dark:bg-[color-mix(in_srgb,var(--c)_20%,var(--card))]",
  plain: "border-border/70 bg-card",
}

function cardStyle(
  course: Course,
  color: string,
  now: Date | null,
  isNext: boolean
) {
  const hex = isHexColor(color)
  const minutes =
    course.start && course.end
      ? Math.round((course.end.getTime() - course.start.getTime()) / 60_000)
      : null
  const ongoing = now !== null && isOngoing(course, now)
  const style: CSSProperties = hex ? ({ "--c": color } as CSSProperties) : {}
  if (minutes) {
    style.minHeight = Math.round(minutes * (76 / 55))
    style.flexGrow = minutes
  }
  const surface = course.cancelled
    ? surfaces.cancelled
    : hex
      ? surfaces.tinted
      : surfaces.plain

  return {
    ongoing,
    style,
    surface,
    stripe: course.cancelled
      ? "bg-destructive/70"
      : hex
        ? "bg-[var(--c)]"
        : "bg-border",
    compact: minutes !== null && minutes < 45,
    tone: course.cancelled
      ? "text-muted-foreground"
      : hex
        ? textTone
        : "text-card-foreground",
    nowBadge: ongoing
      ? "En cours"
      : isNext && now && course.start
        ? countdownLabel(now, course.start)
        : null,
  }
}

function Badges({
  course,
  nowBadge,
  ongoing,
}: {
  course: Course
  nowBadge: string | null
  ongoing: boolean
}) {
  const flags = courseFlags(course).filter((flag) => flag.key !== "session")
  if (!nowBadge && flags.length === 0) return null

  return (
    <span className="flex flex-wrap gap-1 pt-0.5">
      {nowBadge && (
        <span
          className={cn(
            "flex items-center gap-1.5 rounded-full px-2 py-px text-[11px] font-semibold",
            ongoing
              ? "bg-primary text-primary-foreground"
              : "bg-primary/15 text-primary-text"
          )}
        >
          {ongoing && (
            <span className="relative flex size-1.5">
              <span className="absolute inline-flex size-full animate-[progress-pulse_1.6s_ease-in-out_infinite] rounded-full bg-current" />
              <span className="relative inline-flex size-1.5 rounded-full bg-current" />
            </span>
          )}
          {nowBadge}
        </span>
      )}
      {flags.map((flag) => (
        <span
          key={flag.key}
          className={cn(
            "rounded-full px-2 py-px text-[11px] font-semibold",
            pillTones[flag.tone],
            flag.icon && "flex items-center gap-1"
          )}
        >
          {flag.icon && (
            <HugeiconsIcon
              icon={flag.icon}
              className="size-3"
              aria-hidden="true"
            />
          )}
          {flag.label}
        </span>
      ))}
    </span>
  )
}

function Meta({ course, tone }: { course: Course; tone: string }) {
  return (
    <span
      className={cn(
        "flex min-w-0 items-center gap-1.5 text-[13px] font-semibold opacity-80",
        tone
      )}
    >
      {course.room && (
        <span className="flex min-w-0 items-center gap-1">
          <HugeiconsIcon
            icon={Location01Icon}
            className="size-4 shrink-0"
            aria-hidden="true"
          />
          <span className="truncate">{course.room}</span>
        </span>
      )}
      {course.room && course.teacher && (
        <span
          aria-hidden="true"
          className="h-5 w-0.5 shrink-0 rounded-full bg-current opacity-40"
        />
      )}
      {course.teacher && (
        <span className="flex min-w-0 flex-1 items-center gap-1">
          <HugeiconsIcon
            icon={User02Icon}
            className="size-4 shrink-0"
            aria-hidden="true"
          />
          <span className="truncate">{course.teacher}</span>
        </span>
      )}
    </span>
  )
}

export function CourseCard({
  course,
  now,
  isNext,
  onSelect,
}: {
  course: Course
  now: Date | null
  isNext: boolean
  onSelect: (course: Course) => void
}) {
  const { display, color } = useSubjectDisplay(course.subjectCode, course.title)
  const card = cardStyle(course, color, now, isNext)
  const showMeta = !card.compact && Boolean(course.room || course.teacher)
  const showDetails =
    !card.compact && Boolean(course.details) && !course.cancelled

  return (
    <m.button
      type="button"
      whileTap={{ scale: 0.98 }}
      transition={{ type: "spring", stiffness: 500, damping: 30 }}
      onClick={() => {
        onSelect(course)
      }}
      style={card.style}
      className={cn(
        "flex min-w-0 items-stretch gap-3 rounded-2xl border p-3.5 text-left outline-none",
        "transition-[box-shadow,background-color] duration-200",
        "hover:shadow-sm focus-visible:ring-2 focus-visible:ring-ring/50",
        card.surface
      )}
    >
      <span
        aria-hidden="true"
        className={cn("w-1.5 shrink-0 self-stretch rounded-full", card.stripe)}
      />
      <span className="flex min-w-0 flex-1 flex-col justify-center gap-1">
        <span
          className={cn(
            "leading-snug font-bold",
            card.compact ? "truncate text-[15px]" : "line-clamp-2 text-[15px]",
            course.cancelled
              ? "text-destructive line-through decoration-destructive/60"
              : card.tone
          )}
        >
          {display}
        </span>

        {showMeta && <Meta course={course} tone={card.tone} />}

        {showDetails && (
          <span className="truncate text-xs text-muted-foreground">
            {course.details}
          </span>
        )}

        <Badges
          course={course}
          nowBadge={card.nowBadge}
          ongoing={card.ongoing}
        />
      </span>
    </m.button>
  )
}
