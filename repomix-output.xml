<file path="src/pages/agenda/hooks/useAgenda.ts">
import { useCallback, useEffect, useState } from "react"
import { ld } from "@/services/litedirecte"
import { errorMessage } from "@/services/errors"

import { useLiveRefresh } from "@/hooks/use-live-refresh"
import { normalizeTimetable } from "../helpers"
import { addDays, parseDateKey, toDayKey } from "@/services/dates"
import { ensureSubjects, resolveSubjectColor } from "@/services/subjects"
import type { Course } from "../helpers"

const weekCache = new Map<string, Course[]>()
const fetchedWeeks = new Set<string>()
const failedWeeks = new Set<string>()
const inflight = new Map<string, Promise<Course[]>>()

async function fetchWeek(startKey: string, endKey: string): Promise<Course[]> {
  const cached = inflight.get(startKey)
  if (cached) return cached
  const promise = (async () => {
    const restored = await ld.auth.loadSession()
    if (!restored) throw new Error("Aucune session active. Reconnecte-toi.")
    const payload = await ld.timetable.getTimetable({
      startDate: startKey,
      endDate: endKey,
    })
    // No `force`: on a live refresh the poll has just rewritten this entry, so
    // the cached read is free and still current.
    const list = normalizeTimetable(payload)
    void ensureSubjects(
      list.map((course) => ({
        code: course.subjectCode,
        name: course.title,
      }))
    )
    return list.map((course) => ({
      ...course,
      color: resolveSubjectColor(course.subjectCode, course.title),
    }))
  })()
  inflight.set(startKey, promise)
  try {
    const list = await promise
    weekCache.set(startKey, list)
    fetchedWeeks.add(startKey)
    failedWeeks.delete(startKey)
    return list
  } catch (err) {
    failedWeeks.add(startKey)
    throw err
  } finally {
    inflight.delete(startKey)
  }
}

function neighborKeys(startKey: string): Array<{ start: string; end: string }> {
  const monday = parseDateKey(startKey)
  if (!monday) return []
  const prevMonday = addDays(monday, -7)
  const nextMonday = addDays(monday, 7)
  return [
    { start: toDayKey(prevMonday), end: toDayKey(addDays(prevMonday, 6)) },
    { start: toDayKey(nextMonday), end: toDayKey(addDays(nextMonday, 6)) },
  ]
}

export function useAgenda(startKey: string, endKey: string) {
  const [courses, setCourses] = useState<Course[]>(
    () => weekCache.get(startKey) ?? []
  )
  const [loading, setLoading] = useState(() => !weekCache.has(startKey))
  const [refreshing, setRefreshing] = useState(false)
  const [error, setError] = useState<string | null>(null)
  const [failedSnapshot, setFailedSnapshot] = useState<string[]>([])
  const [reloadKey, setReloadKey] = useState(0)
  const liveTimetable = useLiveRefresh("timetable")

  useEffect(() => {
    let cancelled = false
    const hadCache = weekCache.has(startKey)
    if (!hadCache) {
      setLoading(true)
      setCourses([])
    } else {
      setCourses(weekCache.get(startKey) ?? [])
      setRefreshing(true)
    }
    setError(null)

    ;(async () => {
      try {
        const list = await fetchWeek(startKey, endKey)
        if (cancelled) return
        setCourses(list)
        setError(null)
      } catch (err) {
        if (cancelled) return
        const fallback = weekCache.get(startKey)
        if (fallback && fallback.length > 0) {
          setCourses(fallback)
          setError(null)
        } else {
          setCourses([])
          setError(
            errorMessage(err, "Impossible de charger l'emploi du temps.")
          )
        }
      } finally {
        if (!cancelled) {
          setLoading(false)
          setRefreshing(false)
          setFailedSnapshot([...failedWeeks])
        }
      }
    })()

    const prefetchTimer = setTimeout(() => {
      if (cancelled) return
      for (const n of neighborKeys(startKey)) {
        if (fetchedWeeks.has(n.start) || inflight.has(n.start)) continue
        fetchWeek(n.start, n.end).catch(() => {})
      }
    }, 100)

    return () => {
      cancelled = true
      clearTimeout(prefetchTimer)
    }
  }, [startKey, endKey, reloadKey, liveTimetable])

  const refresh = useCallback(() => {
    fetchedWeeks.delete(startKey)
    setRefreshing(true)
    setReloadKey((key) => key + 1)
  }, [startKey])

  return {
    courses,
    loading,
    refreshing,
    error,
    failedWeeks: failedSnapshot,
    setError,
    setLoading,
    setReloadKey,
    refresh,
  }
}
</file>

<file path="src/pages/agenda/hooks/useAgendaPage.ts">
"use client"

import { useCallback, useEffect, useMemo, useRef, useState } from "react"
import { useNavigate, useSearchParams } from "react-router"
import { getSetting } from "@/services/storage"
import { addDays, parseDateKey, toDayKey, weekOf } from "@/services/dates"
import { triggerHapticLight } from "@/services/haptics"
import { coursesForDay, type AgendaView, type Course } from "../helpers"
import { useAgenda } from "./useAgenda"

const SWIPE_PX = 60

function useStoredWeekView(
  params: URLSearchParams,
  setParams: (p: URLSearchParams) => void
) {
  const hasVue = params.has("vue")

  useEffect(() => {
    if (hasVue) return
    void getSetting("agendaView").then((stored) => {
      if (stored !== "week") return
      const next = new URLSearchParams(params.toString())
      next.set("vue", "semaine")
      setParams(next)
    })
    // eslint-disable-next-line react-hooks/exhaustive-deps -- restore the stored default once
  }, [hasVue])
}

export function useAgendaPage() {
  const [searchParams, setSearchParams] = useSearchParams()
  const navigate = useNavigate()
  const [navDir, setNavDir] = useState(0)
  const touchStart = useRef<{ x: number; y: number } | null>(null)
  // True when the drawer was opened in-session (push): closing it then goes
  // back instead of replacing, so Android's back button closes the drawer
  // first. Deep links (?cours= opened directly) still close via replace.
  const pushedDrawer = useRef(false)

  const dateParam = searchParams.get("date")
  const date = useMemo(() => parseDateKey(dateParam) ?? new Date(), [dateParam])
  const view: AgendaView =
    searchParams.get("vue") === "semaine" ? "week" : "day"
  const courseParam = searchParams.get("cours")

  const week = weekOf(date)
  const startKey = toDayKey(week[0])
  const endKey = toDayKey(week[6])

  const { courses, loading, error, refresh } = useAgenda(startKey, endKey)

  const sorted = useMemo(
    () =>
      [...courses].sort(
        (a, b) => (a.start?.getTime() ?? 0) - (b.start?.getTime() ?? 0)
      ),
    [courses]
  )
  const dayCourses = coursesForDay(sorted, toDayKey(date))
  const weekCourses = useMemo(
    () =>
      sorted.filter((c) => {
        if (!c.start) return false
        const key = toDayKey(c.start)
        return key >= startKey && key <= endKey
      }),
    [sorted, startKey, endKey]
  )

  const selected = useMemo(
    () =>
      courseParam
        ? (sorted.find((c) => c.stableId === courseParam) ?? null)
        : null,
    [sorted, courseParam]
  )

  const commit = useCallback(
    (mutate: (params: URLSearchParams) => void) => {
      const params = new URLSearchParams(searchParams.toString())
      mutate(params)
      setSearchParams(params, { replace: true })
    },
    [searchParams, setSearchParams]
  )

  const setDate = useCallback(
    (next: Date, dir?: number) => {
      const current = toDayKey(date)
      const target = toDayKey(next)
      if (target !== current) triggerHapticLight()
      setNavDir(dir ?? (target > current ? 1 : target < current ? -1 : 0))
      // Changing day drops the drawer state, including its history entry.
      pushedDrawer.current = false
      commit((params) => {
        if (target === toDayKey(new Date())) params.delete("date")
        else params.set("date", target)
        params.delete("cours")
      })
    },
    [date, commit]
  )

  const setView = useCallback(
    (next: AgendaView) => {
      if (next === view) return
      triggerHapticLight()
      commit((params) => {
        if (next === "week") params.set("vue", "semaine")
        else params.delete("vue")
      })
    },
    [commit, view]
  )

  const select = useCallback(
    (course: Course | null) => {
      if (course) {
        if (course.stableId !== courseParam) triggerHapticLight()
        pushedDrawer.current = true
        const params = new URLSearchParams(searchParams.toString())
        params.set("cours", course.stableId)
        setSearchParams(params)
        return
      }
      if (pushedDrawer.current) {
        pushedDrawer.current = false
        navigate(-1)
        return
      }
      commit((params) => {
        params.delete("cours")
      })
    },
    [commit, courseParam, navigate, searchParams, setSearchParams]
  )

  useStoredWeekView(
    searchParams,
    useCallback(
      (params) => setSearchParams(params, { replace: true }),
      [setSearchParams]
    )
  )

  const step = useCallback(
    (delta: number) =>
      setDate(addDays(date, view === "week" ? delta * 7 : delta), delta),
    [date, view, setDate]
  )

  useEffect(() => {
    const onKey = (e: KeyboardEvent) => {
      const tag = (e.target as HTMLElement | null)?.tagName
      if (tag && /^(INPUT|TEXTAREA|SELECT)$/.test(tag)) return
      if (e.key === "ArrowLeft") {
        e.preventDefault()
        step(-1)
      } else if (e.key === "ArrowRight") {
        e.preventDefault()
        step(1)
      }
    }
    window.addEventListener("keydown", onKey)
    return () => window.removeEventListener("keydown", onKey)
  }, [step])

  const swipe = useMemo(
    () => ({
      onTouchStart: (e: React.TouchEvent) => {
        touchStart.current =
          e.touches.length === 1
            ? { x: e.touches[0].clientX, y: e.touches[0].clientY }
            : null
      },
      onTouchEnd: (e: React.TouchEvent) => {
        const origin = touchStart.current
        touchStart.current = null
        if (!origin) return
        const touch = e.changedTouches[0]
        const dx = touch.clientX - origin.x
        const dy = touch.clientY - origin.y
        if (Math.abs(dx) < SWIPE_PX || Math.abs(dx) < Math.abs(dy) * 1.4) return
        step(dx < 0 ? 1 : -1)
      },
    }),
    [step]
  )

  return {
    date,
    view,
    navDir,
    dayCourses,
    weekCourses,
    visible: view === "week" ? weekCourses : dayCourses,
    selected,
    loading,
    error,
    refresh,
    setDate,
    setView,
    select,
    swipe,
  }
}
</file>

<file path="src/pages/agenda/hooks/useSessionContent.ts">
"use client"

import { useEffect, useState } from "react"
import { getFriendlyErrorMessage } from "litedirecte"
import { ld } from "@/services/litedirecte"
import { toDayKey } from "@/services/dates"
import type { Course } from "../helpers"
import type { HomeworkDocument } from "@/pages/homework/helpers"

export interface SessionContent {
  html?: string
  documents: HomeworkDocument[]
}

const dayCache = new Map<string, Array<Record<string, unknown>>>()
const inflight = new Map<string, Promise<Array<Record<string, unknown>>>>()

function entriesOf(payload: unknown): Array<Record<string, unknown>> {
  if (Array.isArray(payload)) return payload as Array<Record<string, unknown>>
  if (payload && typeof payload === "object") {
    const record = payload as Record<string, unknown>
    for (const key of ["matieres", "subjects"]) {
      if (Array.isArray(record[key]))
        return record[key] as Array<Record<string, unknown>>
    }
  }
  return []
}

function toDocuments(files: unknown): HomeworkDocument[] {
  if (!Array.isArray(files)) return []
  return (files as Array<Record<string, unknown>>)
    .map((file): HomeworkDocument | null => {
      if (typeof file?.libelle !== "string" || !file.libelle) return null
      const id = Number(file.id)
      return {
        id: Number.isFinite(id) ? id : 0,
        name: file.libelle,
        type: typeof file.type === "string" ? file.type : "FICHIER_CDT",
        size: typeof file.taille === "number" ? file.taille : undefined,
      }
    })
    .filter((file): file is HomeworkDocument => file !== null)
}

function matchesSubject(
  entry: Record<string, unknown>,
  code: string,
  title: string
): boolean {
  const entryCode =
    typeof entry.codeMatiere === "string"
      ? entry.codeMatiere.trim().toLowerCase()
      : ""
  if (code && entryCode) return entryCode === code
  const entryName =
    typeof entry.matiere === "string" ? entry.matiere.trim().toLowerCase() : ""
  return !!entryName && entryName === title
}

function toSession(
  entries: Array<Record<string, unknown>>,
  code: string,
  title: string
): SessionContent {
  const entry = entries.find((e) => matchesSubject(e, code, title))
  const detail = entry?.contenuDeSeance as Record<string, unknown> | undefined
  const html =
    typeof detail?.contenu === "string" && detail.contenu.trim()
      ? detail.contenu
      : undefined
  return { html, documents: toDocuments(detail?.documents) }
}

async function fetchDayEntries(dayKey: string) {
  const cached = inflight.get(dayKey)
  if (cached) return cached
  const promise = (async () => {
    const raw = (await ld.homework.getHomeworkForDate(dayKey)) as unknown
    const entries = entriesOf(raw)
    dayCache.set(dayKey, entries)
    return entries
  })()
  inflight.set(dayKey, promise)
  try {
    return await promise
  } finally {
    inflight.delete(dayKey)
  }
}

export function useSessionContent(course: Course | null) {
  const dayKey = course?.start ? toDayKey(course.start) : ""
  const code = course?.subjectCode?.trim().toLowerCase() ?? ""
  const title = course?.title.trim().toLowerCase() ?? ""

  const [session, setSession] = useState<SessionContent | null>(null)
  const [loading, setLoading] = useState(false)
  const [error, setError] = useState<string | null>(null)
  const [reloadKey, setReloadKey] = useState(0)

  useEffect(() => {
    if (!dayKey) {
      setSession(null)
      setError(null)
      setLoading(false)
      return
    }
    let cancelled = false
    const fastHit = dayCache.get(dayKey)
    if (fastHit) {
      setSession(toSession(fastHit, code, title))
      setError(null)
      setLoading(false)
      return
    }
    setLoading(true)
    setError(null)
    ;(async () => {
      try {
        const entries = await fetchDayEntries(dayKey)
        if (cancelled) return
        setSession(toSession(entries, code, title))
      } catch (err) {
        if (cancelled) return
        const errCode = (err as { code?: string } | null)?.code
        setError(
          errCode
            ? getFriendlyErrorMessage(
                errCode,
                "Impossible de charger le contenu de séance."
              )
            : err instanceof Error
              ? err.message
              : "Impossible de charger le contenu de séance."
        )
      } finally {
        if (!cancelled) setLoading(false)
      }
    })()
    return () => {
      cancelled = true
    }
  }, [dayKey, code, title, reloadKey])

  return {
    session,
    loading: !!dayKey && loading,
    error: dayKey ? error : null,
    retry: () => {
      dayCache.delete(dayKey)
      setReloadKey((key) => key + 1)
    },
  }
}
</file>

