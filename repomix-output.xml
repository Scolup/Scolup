// Mappage Windows-1252 des références numériques 128-159 (comme les
// navigateurs) : 128 donne € et 146 ', pas des contrôles invisibles.
const win1252: Record<number, string> = {
  128: "€",
  130: "‚",
  131: "ƒ",
  132: "„",
  133: "…",
  134: "†",
