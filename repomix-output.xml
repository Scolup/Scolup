import { Fragment } from "react"
import { formatTime, minutesOfDay } from "@/services/dates"
import {
  buildGaps,
  concurrentGroups,
  groupColumns,
  nextCourse,
  SEPARATOR_MIN_MINUTES,
  type Course,
  type Gap,
  type TimedCourse,
} from "../helpers"
import { CourseCard } from "./CourseCard"
import { GapSeparator } from "./GapSeparator"

const PX_PER_MIN = 76 / 55

function TimeGutter({ start, end }: { start: Date; end: Date }) {
  return (
    <span className="flex w-14 shrink-0 flex-col items-center justify-center gap-0.5 tabular-nums">
      <span className="text-[13px] font-bold text-card-foreground">
        {formatTime(start)}
      </span>
      <span className="text-[11px] text-muted-foreground">
        {formatTime(end)}
      </span>
    </span>
  )
}

function TimeSpacer({ minutes }: { minutes: number }) {
  if (minutes <= 0) return null
  return <div aria-hidden="true" style={{ height: minutes * PX_PER_MIN }} />
}

function longGaps(courses: TimedCourse[]): Map<number, Gap> {
  return new Map(
    buildGaps(courses)
      .filter((gap) => gap.end - gap.start >= SEPARATOR_MIN_MINUTES)
      .map((gap) => [gap.end, gap])
  )
}

function CourseCluster({
  courses,
  now,
  nextKey,
  onSelect,
}: {
  courses: TimedCourse[]
  now: Date | null
  nextKey: string | null
  onSelect: (course: Course) => void
}) {
  const columns = groupColumns(courses)
  const base = minutesOfDay(courses[0].start)
  const start = courses.reduce(
    (earliest, course) => (course.start < earliest ? course.start : earliest),
    courses[0].start
  )
  const end = courses.reduce(
    (latest, course) => (course.end > latest ? course.end : latest),
    courses[0].end
  )

  return (
    <div className="flex w-full gap-2.5">
      <TimeGutter start={start} end={end} />
      <div className="flex min-w-0 flex-1 gap-2.5">
        {columns.map((column, ci) => {
          const pauses = longGaps(column)
          return (
            <div key={ci} className="flex min-w-0 flex-1 flex-col gap-1.5">
              <TimeSpacer minutes={minutesOfDay(column[0].start) - base} />
              {column.map((course, i) => {
                const pause =
                  i > 0 ? pauses.get(minutesOfDay(course.start)) : undefined
                const silent =
                  i > 0 && !pause
                    ? minutesOfDay(course.start) -
                      minutesOfDay(column[i - 1].end)
                    : 0
                return (
                  <Fragment key={course.key}>
                    {pause && <GapSeparator bare gap={pause} />}
                    <TimeSpacer minutes={silent} />
                    <CourseCard
                      course={course}
                      now={now}
                      isNext={course.key === nextKey}
                      onSelect={onSelect}
                    />
                  </Fragment>
                )
              })}
            </div>
          )
        })}
      </div>
    </div>
  )
}

export function DaySchedule({
  courses,
  showNow,
  onSelect,
}: {
  courses: Course[]
  showNow?: boolean
  onSelect: (course: Course) => void
}) {
  const now = showNow ? new Date() : null
  const groups = concurrentGroups(courses)
  const timed = groups.flat()
  const nextKey = now ? (nextCourse(timed, now)?.key ?? null) : null
  const separators = longGaps(timed)

  return (
    <ol className="flex flex-col gap-1.5">
      {groups.map((group) => {
        const separator = separators.get(minutesOfDay(group[0].start))
        return (
          <Fragment key={group[0].key}>
            {separator && (
              <li>
                <GapSeparator gap={separator} />
              </li>
            )}
            <li>
              <CourseCluster
                courses={group}
                now={now}
                nextKey={nextKey}
                onSelect={onSelect}
              />
            </li>
          </Fragment>
        )
      })}
    </ol>
  )
}
</file>

<file path="src/pages/grades/components/AverageCard.tsx">
import { lazy, Suspense, useEffect, useRef, useState } from "react"
import {
  countUpValue,
  formatAverage,
  formatAverageValue,
  type TrendPoint,
} from "../helpers"
import { useAverageSettings } from "@/services/average-settings"
import { AnimatedNumber } from "@/ui/animated-number"

const GradesTrendChart = lazy(() =>
  import("./GradesTrendChart").then((m) => ({ default: m.GradesTrendChart }))
)

// Count-up honnête (valeur réelle interpolée, ~700 ms ease-out) : la moyenne
// est le chiffre émotionnel de l'app, elle mérite le seul moment expressif.
// Reduced-motion : valeur directe, sans mouvement.
function useCountUp(target: number): number {
  const [value, setValue] = useState(target)
  const from = useRef(target)
  useEffect(() => {
    if (
      window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
      from.current === target
    ) {
      setValue(target)
      from.current = target
      return
    }
    const start = from.current
    const t0 = performance.now()
    const duration = 700
    let raf = 0
    const tick = (now: number) => {
      const progress = (now - t0) / duration
      setValue(countUpValue(start, target, progress))
      if (progress < 1) raf = requestAnimationFrame(tick)
      else from.current = target
    }
    raf = requestAnimationFrame(tick)
    return () => {
      cancelAnimationFrame(raf)
      from.current = target
    }
  }, [target])
  return value
}

export function AverageCard({
  average,
  focusedAverage,
  onFocusAverage,
  trend,
  trendDomain,
  hasTrend,
}: {
  average: number
  focusedAverage?: number | null
  onFocusAverage?: (average: number | null) => void
  trend: TrendPoint[]
  trendDomain: [number, number]
  hasTrend: boolean
}) {
  const { scale } = useAverageSettings()
  const animated = useCountUp(average)
  // Tant qu'un point du graphe a le focus, sa moyenne s'affiche en direct
  // (sans count-up : le doigt pilote) ; au relâcher, retour à la moyenne.
  const shown = focusedAverage ?? animated
  return (
    <section
      aria-label={`Moyenne générale : ${formatAverage(average, scale)}`}
      className="flex flex-col gap-1 rounded-3xl border border-border/70 bg-card px-4 pt-3.5 pb-2"
    >
      <div className="flex items-center justify-between gap-3">
        <span className="text-sm font-semibold text-card-foreground">
          Moyenne générale
        </span>
        <span className="tabular-nums">
          <AnimatedNumber
            value={formatAverageValue(shown, scale)}
            className="text-2xl font-bold text-card-foreground"
          />
          <span className="text-xs text-muted-foreground">
            {scale === 100 ? " %" : `/${scale}`}
          </span>
        </span>
      </div>
      {hasTrend && (
        <Suspense
          fallback={
            <div aria-hidden="true" className="h-[140px] w-full md:h-[220px]" />
          }
        >
          <GradesTrendChart
            trend={trend}
            domain={trendDomain}
            onFocus={onFocusAverage}
          />
        </Suspense>
      )}
    </section>
  )
}
</file>

