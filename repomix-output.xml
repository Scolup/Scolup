<file path="src/pages/messages/hooks/useCompose.ts">
import { useCallback, useState } from "react"
import { ld } from "@/services/litedirecte"
import { errorMessage } from "@/services/errors"
import { triggerHapticLight, triggerHapticMedium } from "@/services/haptics"
import {
  buildReplyBody,
  buildReplySubject,
  resolveReplyRecipient,
  toMessageHtml,
  validateCompose,
  type Contact,
  type Message,
} from "../helpers"

export type ComposeMode = "new" | "reply"

export type ComposeStep = 1 | 2

export function useCompose(onSent?: () => void) {
  const [open, setOpen] = useState(false)
  const [mode, setMode] = useState<ComposeMode>("new")
  const [step, setStep] = useState<ComposeStep>(1)
  const [replySender, setReplySender] = useState<string | undefined>(undefined)
  const [recipients, setRecipients] = useState<Contact[]>([])
  const [search, setSearch] = useState("")
  const [subject, setSubject] = useState("")
  const [content, setContent] = useState("")
  const [attachments, setAttachments] = useState<File[]>([])
  const [sending, setSending] = useState(false)
  const [error, setError] = useState<string | null>(null)
  const [sent, setSent] = useState(false)

  const reset = useCallback(() => {
    setMode("new")
    setStep(1)
    setReplySender(undefined)
    setRecipients([])
    setSearch("")
    setSubject("")
    setContent("")
    setAttachments([])
    setSending(false)
    setError(null)
    setSent(false)
  }, [])

  const openNew = useCallback(() => {
    reset()
    triggerHapticLight()
    setOpen(true)
  }, [reset])

  const openReply = useCallback(
    (message: Message, contacts: Contact[]) => {
      reset()
      const resolved = resolveReplyRecipient(message, contacts)
      const nextRecipients = resolved ? [resolved] : []
      const nextSubject = buildReplySubject(message.subject)
      const nextBody = buildReplyBody(message)
      setRecipients(nextRecipients)
      // ponytail: sans destinataire résolu (ni ID ni nom connu),
      // on pré-remplit la recherche pour une sélection manuelle en un tap.
      setSearch(resolved ? "" : (message.sender ?? ""))
      setSubject(nextSubject)
      setContent(nextBody)
      setStep(resolved ? 2 : 1)
      setMode("reply")
      setReplySender(message.sender)
      triggerHapticLight()
      setOpen(true)
    },
    [reset]
  )

  const requestClose = useCallback(() => {
    if (sending) return
    reset()
    setOpen(false)
  }, [sending, reset])

  const clearError = useCallback(() => {
    setError(null)
  }, [])

  const discardDraft = useCallback(() => {
    reset()
    setOpen(false)
  }, [reset])

  const toggleRecipient = useCallback((contact: Contact) => {
    triggerHapticLight()
    setRecipients((prev) =>
      prev.some((r) => r.id === contact.id && r.type === contact.type)
        ? prev.filter((r) => !(r.id === contact.id && r.type === contact.type))
        : [...prev, contact]
    )
  }, [])

  const addAttachments = useCallback((files: FileList | File[]) => {
    const picked = Array.from(files).filter((f) => f.size > 0)
    if (picked.length === 0) return
    setAttachments((prev) => [...prev, ...picked])
  }, [])

  const removeAttachment = useCallback((index: number) => {
    setAttachments((prev) => prev.filter((_, i) => i !== index))
  }, [])

  const send = useCallback(async () => {
    const validation = validateCompose(recipients, subject, content)
    if (validation) {
      setError(validation)
      return
    }
    setSending(true)
    setError(null)
    try {
      // ponytail: téléversement à l'envoi, pas à la sélection — le `unc`
      // temporaire est consommé par l'envoi qui suit, aucun état à garder.
      const files: { unc: string; libelle: string }[] = []
      for (const file of attachments) {
        try {
          files.push(await ld.messages.uploadAttachment(file))
        } catch {
          setError(
            `Impossible de téléverser « ${file.name} ». Vérifie ta connexion et réessaie.`
          )
          return
        }
      }
      await ld.messages.sendMessage({
        subject: subject.trim(),
        content: toMessageHtml(content),
        destinataires: recipients.map((r) => r.raw),
        files,
      })
      triggerHapticMedium()
      setSent(true)
      onSent?.()
    } catch (err) {
      setError(errorMessage(err, "Impossible d'envoyer ce message."))
    } finally {
      setSending(false)
    }
  }, [recipients, subject, content, attachments, onSent])

  return {
    open,
    mode,
    step,
    setStep,
    replySender,
    recipients,
    search,
    setSearch,
    subject,
    setSubject,
    content,
    setContent,
    attachments,
    addAttachments,
    removeAttachment,
    sending,
    error,
    sent,
    openNew,
    openReply,
    requestClose,
    discardDraft,
    toggleRecipient,
    send,
    clearError,
    reset,
  }
}

export type ComposeState = ReturnType<typeof useCompose>
</file>

<file path="src/pages/messages/helpers.ts">
import { Archive04Icon, SentIcon } from "@hugeicons/core-free-icons"

import { initialsFromName } from "@/lib/utils"
import { decodeHtmlEntities, htmlToText } from "@/services/html"

export type FolderKey = "inbox" | "sent"

export interface Attachment {
  id: number
  name: string
  type: string
}

export interface MessageRecipient {
  name?: string
  civilite?: string
  prenom?: string
  nom?: string
  role?: string
  id?: number | string
}

export interface Message {
  id: number
  sender?: string
  senderId?: number
  senderType?: string
  recipients?: string[]
  subject?: string
  body?: string
  time?: Date
  hasAttachment?: boolean
  attachments?: Attachment[]
  unread?: boolean
  initials?: string
  sent?: boolean
}

export interface MessageEntry {
  id: number
  subject?: string
  contenu?: string
  content?: string
  fromName?: string
  from?: {
    prenom?: string
    nom?: string
    id?: number | string
    role?: string
    type?: string
  }
  to?: MessageRecipient[]
  date?: Date
  files?: unknown[]
  read?: boolean
  message?: { contenu?: string }
}

export const PAGE_SIZE = 15

export function toLists(messages: {
  received?: MessageEntry[]
  sent?: MessageEntry[]
}): Record<FolderKey, Message[]> {
  return {
    inbox: (messages?.received ?? []).map(toMessage),
    sent: (messages?.sent ?? []).map((m) => ({ ...toMessage(m), sent: true })),
  }
}

const now = new Date()
const year = now.getFullYear()
export const MESSAGE_YEAR =
  now.getMonth() >= 8 ? `${year}-${year + 1}` : `${year - 1}-${year}`

export const skeletonSenderWidths = ["w-28", "w-24", "w-32", "w-20", "w-28"]
export const skeletonSubjectWidths = [
  "w-2/3",
  "w-4/5",
  "w-1/2",
  "w-3/4",
  "w-3/5",
]

const folderLabels: Record<FolderKey, string> = {
  inbox: "Principal",
  sent: "Envoyés",
}

export function folderIcon(value: FolderKey): typeof Archive04Icon {
  if (value === "sent") return SentIcon
  return Archive04Icon
}

export function folderLabel(value: FolderKey): string {
  return folderLabels[value]
}

export function parseFolderParam(param: string | null): FolderKey {
  if (param === "sent") return "sent"
  return "inbox"
}

export function serializeFolderParam(value: FolderKey): string | null {
  if (value === "sent") return "sent"
  return null
}

function decodeBase64Content(value: string): string {
  const compact = value.replace(/\s+/g, "")
  if (compact.length < 4) return value
  try {
    const bytes = Uint8Array.from(atob(compact), (c) => c.charCodeAt(0))
    const decoded = new TextDecoder("utf-8").decode(bytes)
    return decoded.includes("�") ? value : decoded
  } catch {
    return value
  }
}

export function messageBody(detail: MessageEntry): string | undefined {
  const nested = detail.message?.contenu
  const raw =
    detail.contenu ??
    (typeof detail.content === "string" ? detail.content : undefined) ??
    nested
  return raw ? decodeBase64Content(raw) : undefined
}

export function extractAttachments(files: unknown[]): Attachment[] {
  return files
    .map((f) => {
      const obj = f as { id?: number; libelle?: string; type?: string }
      if (!obj.libelle) return null
      const id = typeof obj.id === "number" ? obj.id : Number(obj.id)
      return {
        id: Number.isFinite(id) ? id : 0,
        name: obj.libelle,
        type: obj.type ?? "PIECE_JOINTE",
      } as Attachment
    })
    .filter((x): x is Attachment => x !== null)
}

export function recipientsOf(entry: MessageEntry): string[] {
  return (entry.to ?? [])
    .map((r) => {
      const raw = r.prenom || r.nom ? contactDisplayName(r) : (r.name ?? "")
      return decodeHtmlEntities(raw)
    })
    .filter((name) => name.trim() !== "")
}

export function recipientsLabel(message: {
  sent?: boolean
  recipients?: string[]
}): string | undefined {
  if (!message.sent || !message.recipients?.length) return undefined
  return `À : ${message.recipients.join(", ")}`
}

export function toMessage(entry: MessageEntry): Message {
  const from = entry.from
  const rawName =
    entry.fromName ?? [from?.prenom, from?.nom].filter(Boolean).join(" ") ?? "?"
  const name = decodeHtmlEntities(rawName)
  const attachments = Array.isArray(entry.files)
    ? extractAttachments(entry.files)
    : []
  const sender = senderOf(entry)
  const recipients = recipientsOf(entry)
  return {
    id: entry.id,
    sender: name,
    ...(sender ? { senderId: sender.id } : {}),
    ...(sender?.type ? { senderType: sender.type } : {}),
    ...(recipients.length > 0 ? { recipients } : {}),
    subject: entry.subject ? decodeHtmlEntities(entry.subject) : entry.subject,
    body: messageBody(entry),
    time: entry.date,
    hasAttachment: attachments.length > 0,
    attachments: attachments.length > 0 ? attachments : undefined,
    unread: !entry.read,
    initials: initialsFromName(name),
  }
}

export function countUnreadMessages(messages: Message[]): number {
  return messages.filter((message) => message.unread && !message.sent).length
}

export function buildPagination(
  totalPages: number,
  currentPage: number,
  maxSlots: number
): { pages: number[]; leftEllipsis: boolean; rightEllipsis: boolean } {
  if (totalPages <= maxSlots) {
    return {
      pages: Array.from({ length: totalPages }, (_, i) => i + 1),
      leftEllipsis: false,
      rightEllipsis: false,
    }
  }

  const half = Math.floor((maxSlots - 1) / 2)
  let start = Math.max(1, currentPage - half)
  let end = Math.min(totalPages, currentPage + half)

  if (end - start + 1 < maxSlots) {
    if (start === 1) end = maxSlots
    else start = totalPages - maxSlots + 1
  }

  return {
    pages: Array.from({ length: end - start + 1 }, (_, i) => start + i),
    leftEllipsis: start > 1,
    rightEllipsis: end < totalPages,
  }
}

export function formatFullDate(date: Date): string {
  return date.toLocaleDateString("fr", {
    weekday: "long",
    day: "numeric",
    month: "long",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  })
}

export interface Contact {
  id: number
  type: string
  name: string
  detail?: string
  raw: unknown
}

export function contactDisplayName(entry: {
  prenom?: string
  nom?: string
  civilite?: string
}): string {
  const full = [entry.prenom, entry.nom].filter(Boolean).join(" ").trim()
  if (!full) return "Sans nom"
  return entry.civilite ? `${entry.civilite} ${full}` : full
}

export function toContact(entry: unknown): Contact | null {
  const obj = entry as {
    id?: number | string
    type?: string
    prenom?: string
    nom?: string
    civilite?: string
    matiere?: string
    fonction?: { libelle?: string }
    classes?: { matiere?: string }[]
  }
  const id = typeof obj?.id === "number" ? obj.id : Number(obj?.id)
  if (!obj || !Number.isFinite(id)) return null
  const name = contactDisplayName(obj)
  const detail =
    obj.matiere ||
    obj.classes?.find((c) => c.matiere)?.matiere ||
    obj.fonction?.libelle ||
    undefined
  return {
    id,
    type: typeof obj.type === "string" ? obj.type : "P",
    name,
    detail,
    raw: entry,
  }
}

export function contactTypeLabel(type: string): string {
  if (type === "P") return "Enseignant"
  if (type === "A") return "Personnel"
  return "Contact"
}

export function mergeContacts(entries: unknown[]): Contact[] {
  const seen = new Set<string>()
  const list: Contact[] = []
  for (const entry of entries) {
    const contact = toContact(entry)
    if (!contact) continue
    const key = `${contact.type}-${contact.id}`
    if (seen.has(key)) continue
    seen.add(key)
    list.push(contact)
  }
  list.sort((a, b) => a.name.localeCompare(b.name, "fr"))
  return list
}

export function filterContacts(contacts: Contact[], query: string): Contact[] {
  const normalized = query.trim().toLowerCase()
  if (!normalized) return contacts
  return contacts.filter((c) =>
    `${c.name} ${c.detail ?? ""}`.toLowerCase().includes(normalized)
  )
}

export function findContactForSender(
  sender: string | undefined,
  contacts: Contact[]
): Contact | undefined {
  if (!sender) return undefined
  const normalized = sender.trim().toLowerCase()
  if (!normalized) return undefined
  return contacts.find((c) => c.name.toLowerCase().includes(normalized))
}

export interface SenderRef {
  id: number
  type?: string
}

export function senderOf(entry: MessageEntry): SenderRef | null {
  const from = entry.from
  if (!from) return null
  const id = typeof from.id === "number" ? from.id : Number(from.id)
  if (!Number.isFinite(id)) return null
  const rawType = from.role ?? from.type
  const type = typeof rawType === "string" && rawType ? rawType : undefined
  return type ? { id, type } : { id }
}

export function resolveReplyRecipient(
  message: Message,
  contacts: Contact[]
): Contact | null {
  // ponytail: l'ID expéditeur du payload répond toujours, même quand le
  // nom ne matche aucun contact (homonymes, "Vie scolaire", ...).
  if (message.senderId !== undefined && Number.isFinite(message.senderId)) {
    const byId = contacts.filter((c) => c.id === message.senderId)
    if (byId.length > 0) {
      const typed = message.senderType
        ? byId.find((c) => c.type === message.senderType)
        : undefined
      return typed ?? byId[0]
    }
    if (message.senderType) {
      const raw = { id: message.senderId, type: message.senderType }
      const name = message.sender?.trim() || "Sans nom"
      return { id: message.senderId, type: message.senderType, name, raw }
    }
  }
  return findContactForSender(message.sender, contacts) ?? null
}

export function buildReplySubject(subject?: string): string {
  const clean = subject?.trim() ?? ""
  if (!clean) return "Re: ton message"
  return /^re\s*:/i.test(clean) ? clean : `Re: ${clean}`
}

function stripHtmlTags(html: string): string {
  return htmlToText(html)
}

export function buildReplyBody(message: Message): string {
  const quoted = message.body ? stripHtmlTags(message.body) : ""
  const when = message.time ? formatFullDate(message.time) : null
  const header =
    message.sender && when
      ? `Le ${when}, ${message.sender} écrivait :`
      : message.sender
        ? `${message.sender} écrivait :`
        : "Message d'origine :"
  const lines = quoted
    ? quoted
        .split("\n")
        .map((line) => `> ${line}`)
        .join("\n")
    : "> (sans contenu)"
  return `\n\n${header}\n${lines}`
}

export function validateCompose(
  recipients: Contact[],
  subject: string,
  content: string
): string | null {
  if (recipients.length === 0) return "Choisis au moins un destinataire."
  if (!subject.trim()) return "Ajoute un objet à ton message."
  if (!content.trim()) return "Écris quelques mots avant d'envoyer."
  return null
}

function escapeHtml(text: string): string {
  return text
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#39;")
}

export function toMessageHtml(content: string): string {
  // L'encodage des accents en entités vit dans Litedirecte (sendMessage) :
  // tous ses consommateurs en profitent, pas seulement Scolup.
  return escapeHtml(content.trim()).replace(/\n/g, "<br>")
}

export const MAX_SUBJECT_LENGTH = 120

export interface ComposeDraft {
  recipients: Contact[]
  subject: string
  content: string
}

const EMPTY_DRAFT: ComposeDraft = { recipients: [], subject: "", content: "" }

function recipientKey(r: Contact): string {
  return `${r.type}-${r.id}`
}

export function isDraftDirty(
  current: ComposeDraft,
  initial: ComposeDraft = EMPTY_DRAFT
): boolean {
  if (current.subject !== initial.subject) return true
  if (current.content !== initial.content) return true
  if (current.recipients.length !== initial.recipients.length) return true
  const before = new Set(initial.recipients.map(recipientKey))
  return current.recipients.some((r) => !before.has(recipientKey(r)))
}

export function isDraftEmpty(draft: ComposeDraft): boolean {
  return (
    draft.recipients.length === 0 &&
    !draft.subject.trim() &&
    !draft.content.trim()
  )
}
</file>

