<file path="src/hooks/use-async.ts">
import { useEffect, useState } from "react"

export interface AsyncResult<T> {
  data: T | undefined
  error: unknown
  loading: boolean
}

export function useAsync<T>(
  task: () => Promise<T>,
  deps: readonly unknown[]
): AsyncResult<T> {
  const [result, setResult] = useState<AsyncResult<T>>({
    data: undefined,
    error: null,
    loading: true,
  })

  useEffect(() => {
    let cancelled = false
    // A refetch keeps the value already on screen: `loading` describes the
    // first load only, so a background refresh never blanks the UI.
    setResult((prev) =>
      prev.data === undefined
        ? { data: undefined, error: null, loading: true }
        : { ...prev, error: null }
    )
    task().then(
      (data) => {
        if (!cancelled) setResult({ data, error: null, loading: false })
      },
      (error) => {
        if (cancelled) return
        // A failed refresh leaves the previous data in place: it is seconds
        // old, and the offline banner already says the app is not live. Only a
        // first load with nothing to show reports the error.
        setResult((prev) =>
          prev.data === undefined
            ? { data: undefined, error, loading: false }
            : { ...prev, loading: false }
        )
      }
    )
    return () => {
      cancelled = true
    }
  }, deps)

  return result
}
</file>

<file path="src/hooks/use-delayed-loading.ts">
import { useEffect, useState } from "react"

// Shows `true` only if `loading` stays true longer than `delayMs`. Fast loads
// (< 150 ms) never flash a skeleton; slow loads show one without an
// artificial minimum duration.
export function useDelayedLoading(loading: boolean, delayMs = 150): boolean {
  const [visible, setVisible] = useState(false)

  useEffect(() => {
    if (!loading) {
      setVisible(false)
      return
    }
    const timer = setTimeout(() => setVisible(true), delayMs)
    return () => clearTimeout(timer)
  }, [loading, delayMs])

  return visible
}
</file>

<file path="src/hooks/use-media-query.ts">
import { useEffect, useState } from "react"

export function useMediaQuery(query: string): boolean {
  const [matches, setMatches] = useState(false)

  useEffect(() => {
    const mql = window.matchMedia(query)
    setMatches(mql.matches)

    function onChange(e: MediaQueryListEvent) {
      setMatches(e.matches)
    }

    mql.addEventListener("change", onChange)
    return () => mql.removeEventListener("change", onChange)
  }, [query])

  return matches
}
</file>

<file path="src/hooks/use-micro-interactions.ts">
// Grammaire motion partagée de l'app (façon Papillon `ui/utils/Animation`) :
// un seul easing, deux ressorts, des variants prêts à l'emploi. Toute
// nouvelle animation passe par ici plutôt que de recopier des tableaux
// d'easing.
// `motion-reduce` est géré globalement par le MotionConfig de main.tsx.
export const EASE_OUT = [0.25, 0.1, 0.15, 1] as const

export const SPRING_SOFT = {
  type: "spring",
  stiffness: 300,
  damping: 30,
} as const

export const SPRING_POP = {
  type: "spring",
  stiffness: 500,
  damping: 25,
} as const

export const staggerContainer = (stagger = 0.08, delay = 0.15) =>
  ({
    hidden: { opacity: 0 },
    visible: {
      opacity: 1,
      transition: { staggerChildren: stagger, delayChildren: delay },
    },
  }) as const

export const fadeUp = (y = 16, duration = 0.5) =>
  ({
    hidden: { opacity: 0, y },
    visible: {
      opacity: 1,
      y: 0,
      transition: { duration, ease: EASE_OUT },
    },
  }) as const

// Entrée avec un petit rebond : belles notes, checks, badges.
export const popIn = (delay = 0) =>
  ({
    hidden: { opacity: 0, scale: 0.85 },
    visible: {
      opacity: 1,
      scale: 1,
      transition: { ...SPRING_POP, delay },
    },
  }) as const
</file>

<file path="src/hooks/use-onboarding-navigation.ts">
import { useCallback, useEffect, useState } from "react"
import { useNavigate, useLocation } from "react-router"
import { getSetting, setSetting } from "@/services/storage"

const ONBOARDING_STEPS = ["theme", "login", "welcome"] as const

export type OnboardingStep = (typeof ONBOARDING_STEPS)[number]

const SETUP_STEP_COUNT = ONBOARDING_STEPS.length - 1

export function useOnboardingNavigation() {
  const navigate = useNavigate()
  const location = useLocation()
  const [isRestored, setIsRestored] = useState(false)

  const currentSegment =
    location.pathname.replace(/\/$/, "").split("/").pop() ?? ""
  const stepIndex = ONBOARDING_STEPS.indexOf(currentSegment as OnboardingStep)
  const needsRedirect =
    !currentSegment || currentSegment === "onboarding" || stepIndex === -1
  const currentStepIndex = needsRedirect ? -1 : stepIndex

  useEffect(() => {
    if (!needsRedirect) return

    let cancelled = false
    getSetting("onboardingStep")
      .then((saved) => {
        if (cancelled) return
        const validStep =
          typeof saved === "string" &&
          ONBOARDING_STEPS.includes(saved as OnboardingStep)
        if (validStep) navigate(`/onboarding/${saved}`, { replace: true })
      })
      .catch(() => {})
      .finally(() => {
        if (!cancelled) setIsRestored(true)
      })
    return () => {
      cancelled = true
    }
  }, [needsRedirect, navigate])

  useEffect(() => {
    if (currentStepIndex >= 0) {
      setSetting("onboardingStep", ONBOARDING_STEPS[currentStepIndex])
    }
  }, [currentStepIndex])

  const goToStep = useCallback(
    (target: OnboardingStep) => {
      navigate(`/onboarding/${target}`)
    },
    [navigate]
  )

  const nextStep = useCallback(() => {
    const nextIdx = Math.min(currentStepIndex + 1, ONBOARDING_STEPS.length - 1)
    goToStep(ONBOARDING_STEPS[nextIdx])
  }, [currentStepIndex, goToStep])

  const previousStep = useCallback(() => {
    if (currentStepIndex > 0) goToStep(ONBOARDING_STEPS[currentStepIndex - 1])
  }, [currentStepIndex, goToStep])

  const isSetupStep =
    currentStepIndex >= 0 && currentStepIndex < SETUP_STEP_COUNT
  const progress = isSetupStep ? currentStepIndex : 0
  const isFirstStep = currentStepIndex === 0

  return {
    currentSegment,
    currentStepIndex,
    needsRedirect,
    isRestored,
    nextStep,
    previousStep,
    isSetupStep,
    progress,
    setupStepCount: SETUP_STEP_COUNT,
    isFirstStep,
  }
}
</file>

