<file path="src/onboarding/hooks/useOnboardingFlow.ts">
import { useEffect, useRef, useState } from "react"
import { pageTransitionVariants, type Direction } from "../page-transitions"

export function useStepDirection(currentStepIndex: number) {
  const previousIndex = useRef(currentStepIndex)
  const [direction, setDirection] = useState<Direction>(1)

  useEffect(() => {
    if (currentStepIndex === previousIndex.current) return
    setDirection(currentStepIndex > previousIndex.current ? 1 : -1)
    previousIndex.current = currentStepIndex
  }, [currentStepIndex])

  return { direction, variants: pageTransitionVariants }
}

export function useOnboardingPrefetch() {
  useEffect(() => {
    const timer = window.setTimeout(() => {
      void import("../components/LoginForm")
      void import("../components/Welcome")
    }, 1000)
    return () => window.clearTimeout(timer)
  }, [])
}
</file>

<file path="src/onboarding/OnboardingFlow.tsx">
import { Navigate } from "react-router"
import { AnimatePresence, m } from "motion/react"
import { cn } from "@/lib/utils"
import { useOnboardingNavigation } from "@/hooks/use-onboarding-navigation"
import { OnboardingNavigationHeader } from "./components/NavigationHeader"
import { OnboardingProgressBar } from "./components/ProgressBar"
import { OnboardingStepRenderer } from "./components/StepRenderer"
import {
  useOnboardingPrefetch,
  useStepDirection,
} from "./hooks/useOnboardingFlow"

export function OnboardingFlow({
  className,
  ...props
}: React.ComponentProps<"div">) {
  const {
    currentSegment,
    currentStepIndex,
    needsRedirect,
    isRestored,
    nextStep,
    previousStep,
    isSetupStep,
    progress,
    setupStepCount,
    isFirstStep,
  } = useOnboardingNavigation()

  const { direction, variants } = useStepDirection(currentStepIndex)
  useOnboardingPrefetch()

  if (needsRedirect && isRestored) {
    return <Navigate to="/onboarding/theme" replace />
  }

  if (needsRedirect) {
    return null
  }

  return (
    <div
      className={cn("mx-auto flex w-full max-w-sm flex-col p-6", className)}
      {...props}
    >
      {isSetupStep && !isFirstStep && (
        <OnboardingNavigationHeader onBack={previousStep} />
      )}

      <div className="relative flex min-h-0 flex-1 flex-col justify-center">
        <AnimatePresence mode="wait" custom={direction}>
          <m.div
            key={currentSegment}
            variants={variants}
            initial="initial"
            animate="animate"
            exit="exit"
            custom={direction}
            className="flex flex-col justify-center"
          >
            <OnboardingStepRenderer
              stepIndex={currentStepIndex}
              onNext={nextStep}
            />
          </m.div>
        </AnimatePresence>
      </div>

      {isSetupStep && (
        <OnboardingProgressBar progress={progress} total={setupStepCount} />
      )}
    </div>
  )
}
</file>

<file path="src/onboarding/page-transitions.ts">
import { type Variants } from "motion/react"

export type Direction = 1 | -1

export const pageTransitionVariants: Variants = {
  initial: (direction: Direction = 1) => ({
    opacity: 0,
    x: direction * 40,
  }),
  animate: {
    opacity: 1,
    x: 0,
    transition: { duration: 0.35, ease: [0.25, 0.1, 0.15, 1] },
  },
  exit: (direction: Direction = 1) => ({
    opacity: 0,
    x: direction * -40,
    transition: { duration: 0.2, ease: "easeIn" },
  }),
}
</file>

