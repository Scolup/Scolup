<file path="src/services/service-worker.ts">
// Le service worker garde le squelette de l'app (HTML, JS, CSS, polices,
// icônes) dans le cache : démarrage instantané, moins de trafic sur nos
// serveurs, et l'app s'ouvre encore sans réseau.
//
// La mise à jour, elle, reste pilotée par l'utilisateur : le pop-up compare
// les releases GitHub à la version locale, et son bouton « Mettre à jour »
// demande au nouveau worker de prendre le relais avant de recharger la page.

const SW_URL = "/sw.js"
const SW_SCOPE = "/"

// Le navigateur peut mettre du temps à aller chercher le nouveau worker.
const DOWNLOAD_TIMEOUT_MS = 10_000
// Une fois téléchargé, il doit s'activer presque immédiatement.
const ACTIVATION_TIMEOUT_MS = 5_000

export function registerServiceWorker(): void {
  // En dev, le worker casserait le HMR : on ne l'enregistre qu'en production.
  if (!import.meta.env.PROD) return
  if (!("serviceWorker" in navigator)) return
  navigator.serviceWorker
    .register(SW_URL, { scope: SW_SCOPE })
    .catch((error) => {
      console.warn("Service worker : enregistrement impossible", error)
    })
}

// Télécharge le nouveau worker en arrière-plan, pour que le bouton
// « Mettre à jour » soit instantané quand l'utilisateur l'appuie.
export async function prepareUpdate(): Promise<void> {
  if (!("serviceWorker" in navigator)) return
  const registration = await navigator.serviceWorker.getRegistration()
  if (!registration) return
  try {
    await registration.update()
  } catch {
    // Hors ligne : rien à préparer.
  }
}

function timeout(ms: number): Promise<void> {
  return new Promise((resolve) => setTimeout(resolve, ms))
}

function waitForInstalled(worker: ServiceWorker): Promise<void> {
  return new Promise((resolve) => {
    // Déjà installé : pas d'événement à attendre.
    if (
      worker.state === "installed" ||
      worker.state === "activated" ||
      worker.state === "redundant"
    ) {
      resolve()
      return
    }
    const onStateChange = () => {
      if (
        worker.state === "installed" ||
        worker.state === "activated" ||
        worker.state === "redundant"
      ) {
        worker.removeEventListener("statechange", onStateChange)
        resolve()
      }
    }
    worker.addEventListener("statechange", onStateChange)
  })
}

// Renvoie le nouveau worker s'il est prêt à prendre le relais, null sinon.
async function findNewWorker(
  registration: ServiceWorkerRegistration
): Promise<ServiceWorker | null> {
  // Un worker en attente a déjà été téléchargé : il peut prendre le relais
  // tout de suite.
  if (registration.waiting) return registration.waiting

  // Rien en attente : on demande au navigateur d'aller chercher la nouvelle
  // version du worker.
  try {
    await Promise.race([registration.update(), timeout(DOWNLOAD_TIMEOUT_MS)])
  } catch {
    return null // Hors ligne : le worker actuel reste en place.
  }

  const worker = registration.waiting ?? registration.installing
  if (!worker) return null
  await Promise.race([waitForInstalled(worker), timeout(DOWNLOAD_TIMEOUT_MS)])

  // Seul un worker en attente peut prendre le relais : à la toute première
  // installation, il s'active tout seul.
  return registration.waiting
}

// Met le cache à jour et recharge l'app depuis ce nouveau cache.
export async function applyUpdate(): Promise<void> {
  if (!("serviceWorker" in navigator)) {
    window.location.reload()
    return
  }

  const registration = await navigator.serviceWorker.getRegistration()
  if (!registration) {
    window.location.reload()
    return
  }

  const worker = await findNewWorker(registration)
  if (!worker) {
    // Aucun nouveau build à récupérer : le cache sert la version actuelle.
    window.location.reload()
    return
  }

  // Le nouveau worker s'active et prend le relais, la page repart du cache
  // tout neuf.
  await Promise.race([
    new Promise<void>((resolve) => {
      navigator.serviceWorker.addEventListener(
        "controllerchange",
        () => resolve(),
        { once: true }
      )
      worker.postMessage({ type: "SKIP_WAITING" })
    }),
    timeout(ACTIVATION_TIMEOUT_MS),
  ])

  window.location.reload()
}
</file>

<file path="src/services/shop-rules.ts">
// Pure shop logic: catalog, purchases, weekly recap. No React, no IndexedDB.
//
// ADD AN ITEM -> add one object to SHOP_ITEMS. (A new `kind` also needs a
//                place that applies it, like the accent picker does.)

// Keys of the "shop" IndexedDB store (the ruby balance key lives in rubies.ts).
export const OWNED_KEY = "owned"
export const WEEKS_KEY = "weekly"

export interface ShopItem {
  id: string // never change an id once shipped: purchases are stored by id
  kind: "accent"
  label: string
  price: number
  value: string // accent key stored in the "accent-color" setting
  color: string // hex shown in the shop and in the picker
  foreground: string // text color readable on top of `color`
}

export const SHOP_ITEMS: ShopItem[] = [
  {
    id: "accent-violet",
    kind: "accent",
    label: "Violet",
    price: 150,
    value: "violet",
    color: "#8b5cf6",
    foreground: "#ffffff",
  },
  {
    id: "accent-pink",
    kind: "accent",
    label: "Rose",
    price: 150,
    value: "pink",
    color: "#ec4899",
    foreground: "#ffffff",
  },
  {
    id: "accent-orange",
    kind: "accent",
    label: "Orange",
    price: 150,
    value: "orange",
    color: "#f97316",
    foreground: "#1a1a1a",
  },
  {
    id: "accent-teal",
    kind: "accent",
    label: "Turquoise",
    price: 150,
    value: "teal",
    color: "#14b8a6",
    foreground: "#1a1a1a",
  },
]

// ---- Purchase ------------------------------------------------------------

export type PurchaseStatus = "ok" | "owned" | "poor"

export function purchase(
  item: ShopItem,
  balance: number,
  owned: string[]
): { status: PurchaseStatus; balance: number; owned: string[] } {
  if (owned.includes(item.id)) return { status: "owned", balance, owned }
  if (balance < item.price) return { status: "poor", balance, owned }
  return {
    status: "ok",
    balance: balance - item.price,
    owned: [...owned, item.id],
  }
}

export function parseOwned(raw: unknown): string[] {
  try {
    if (typeof raw !== "string") return []
    const parsed: unknown = JSON.parse(raw)
    return Array.isArray(parsed)
      ? parsed.filter((id): id is string => typeof id === "string")
      : []
  } catch {
    return []
  }
}

// ---- Weekly recap ("beat your last week", never "beat the others") -------

export type WeekStats = Record<string, number> // week key -> rubies earned

const KEPT_WEEKS = 12

export function addToWeek(
  stats: WeekStats,
  week: string,
  amount: number
): WeekStats {
  const next: WeekStats = { ...stats, [week]: (stats[week] ?? 0) + amount }
  const keep = Object.keys(next).sort().slice(-KEPT_WEEKS)
  return Object.fromEntries(keep.map((key) => [key, next[key]]))
}

export function parseWeeks(raw: unknown): WeekStats {
  try {
    if (typeof raw !== "string") return {}
    const parsed: unknown = JSON.parse(raw)
    if (!parsed || typeof parsed !== "object") return {}
    return Object.fromEntries(
      Object.entries(parsed).filter(
        (entry): entry is [string, number] => typeof entry[1] === "number"
      )
    )
  } catch {
    return {}
  }
}

export interface WeekSummary {
  thisWeek: number
  lastWeek: number
  best: number // best of the *previous* weeks
}

export function weekSummary(
  stats: WeekStats,
  thisKey: string,
  lastKey: string
): WeekSummary {
  const best = Math.max(
    0,
    ...Object.entries(stats)
      .filter(([key]) => key !== thisKey)
      .map(([, value]) => value)
  )
  return {
    thisWeek: stats[thisKey] ?? 0,
    lastWeek: stats[lastKey] ?? 0,
    best,
  }
}

// One encouraging sentence, or null when there is nothing nice to say yet.
// Never mentions a loss: a bad week simply shows nothing.
export function weekMessage({
  thisWeek,
  lastWeek,
  best,
}: WeekSummary): string | null {
  if (thisWeek <= 0) return null
  if (best > 0 && thisWeek > best) {
    return `Record personnel : +${thisWeek} cette semaine`
  }
  if (lastWeek > 0 && thisWeek >= lastWeek) {
    return `+${thisWeek} cette semaine : tu fais mieux que la semaine dernière`
  }
  return `+${thisWeek} rubis cette semaine`
}
</file>

<file path="src/services/shop.ts">
import { reloadRubies, RUBIES_KEY } from "./rubies"
import { getDB } from "./storage"
import {
  OWNED_KEY,
  parseOwned,
  parseWeeks,
  purchase,
  SHOP_ITEMS,
  WEEKS_KEY,
  type PurchaseStatus,
  type WeekStats,
} from "./shop-rules"

export interface ShopState {
  owned: string[]
  weeks: WeekStats
}

export const EMPTY_SHOP: ShopState = { owned: [], weeks: {} }

// ponytail: "xp" used to hold lifetime rubies for the removed level system.
// Real XP is coming: delete the stale value once so nobody mistakes it for the
// new one. Remove this after a few releases.
let staleXpDropped = false

export async function loadShop(): Promise<ShopState> {
  try {
    const db = await getDB()
    if (!staleXpDropped) {
      staleXpDropped = true
      await db.delete("shop", "xp")
    }
    const [ownedRaw, weeksRaw] = await Promise.all([
      db.get("shop", OWNED_KEY),
      db.get("shop", WEEKS_KEY),
    ])
    return {
      owned: parseOwned(ownedRaw),
      weeks: parseWeeks(weeksRaw),
    }
  } catch {
    return EMPTY_SHOP
  }
}

// Balance and inventory change in ONE transaction: no ruby is ever spent
// without the item being saved, and the other way around.
export async function buyItem(
  id: string
): Promise<PurchaseStatus | "unknown" | "error"> {
  const item = SHOP_ITEMS.find((candidate) => candidate.id === id)
  if (!item) return "unknown"
  try {
    const db = await getDB()
    const tx = db.transaction("shop", "readwrite")
    const store = tx.objectStore("shop")
    const [balanceRaw, ownedRaw] = await Promise.all([
      store.get(RUBIES_KEY),
      store.get(OWNED_KEY),
    ])
    const balance = typeof balanceRaw === "number" ? balanceRaw : 0
    const result = purchase(item, balance, parseOwned(ownedRaw))
    if (result.status === "ok") {
      await store.put(result.balance, RUBIES_KEY)
      await store.put(JSON.stringify(result.owned), OWNED_KEY)
    }
    await tx.done
    if (result.status === "ok") await reloadRubies()
    return result.status
  } catch {
    return "error"
  }
}
