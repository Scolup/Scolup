/* Tactile uniquement : aucun contour de focus ni flash au toucher dans les
   graphiques. Le wrapper recharts prend le focus via accessibilityLayer et
   chaque navigateur tactile l'habille à sa façon (contour blanc, halo gris)
   sur un nœud imprévisible : on coupe tout, quel que soit l'élément.
   Le clavier (hover: hover) garde ses anneaux d'accessibilité. */
@media (hover: none) {
  [data-slot="chart"] *,
  [data-slot="chart"] *:focus,
  [data-slot="chart"] *:focus-visible {
    outline: none !important;
    -webkit-tap-highlight-color: transparent;
  }
}

@layer base {
  * {
    @apply border-border outline-ring/50;
  }
  body {
    @apply bg-background text-foreground;
    background-image: linear-gradient(
      0deg,
      var(--accent-bg-overlay, transparent) 0%,
      var(--accent-bg-overlay, transparent) 100%
    );
  }
  button:not(:disabled),
  [role="button"]:not(:disabled) {
    cursor: pointer;
  }
  html {
    @apply font-sans;
  }

  * {
    scrollbar-width: none;
  }
  *::-webkit-scrollbar {
    display: none;
  }
}
