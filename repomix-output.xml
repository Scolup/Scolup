  error,
  onRetry,
}: {
  message: Message
  loading?: boolean
  error?: string | null
  onRetry?: () => void
}) {
  return (
    <AnimatePresence mode="wait" initial={false}>
      {loading ? (
        <m.div
          key="skeleton"
          exit={{ opacity: 0 }}
          className="flex flex-col gap-4 py-1"
          aria-hidden="true"
        >
          <div className="flex flex-col gap-2">
            <Skeleton className="h-4 w-full rounded-full" />
